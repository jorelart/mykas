{
    "name":  "mykas",
    "version":  "1.0.0",
    "private":  true,
    "description":  "Aplikasi pencatatan pemasukan dan pengeluaran dengan MySQL serta webhook Evolution API.",
    "main":  "src/server.js",
    "scripts":  {
                    "start":  "node src/server.js",
                    "dev":  "node --watch src/server.js",
                    "push":  "git add . \u0026\u0026 git commit -m \u0027Update\u0027 \u0026\u0026 git push -u origin main",
                    "build:css":  "tailwindcss -i ./static/css/tailwind.input.css -o ./static/css/tailwind.css --minify",
                    "watch:css":  "tailwindcss -i ./static/css/tailwind.input.css -o ./static/css/tailwind.css --watch",
                    "build":  "npm run build:css"
                },
    "engines":  {
                    "node":  "\u003e=20"
                },
    "dependencies":  {
                         "bcryptjs":  "^2.4.3",
                         "connect-flash":  "^0.1.1",
                         "dotenv":  "^16.4.7",
                         "ejs":  "^3.1.10",
                         "express":  "^4.21.2",
                         "express-mysql-session":  "^3.0.3",
                         "express-session":  "^1.18.1",
                         "helmet":  "^8.0.0",
                         "mysql2":  "^3.12.0",
                         "sweetalert2":  "^11.0.0"
                     },
    "devDependencies":  {
                            "@tailwindcss/cli":  "^4.3.4",
                            "tailwindcss":  "^4.3.4"
                        }
}
