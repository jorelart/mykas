<%- include('partials/header') %>
<div class="page-heading">
  <div><div class="eyebrow"><%= editing ? 'PERUBAHAN PENCATATAN' : 'PENCATATAN MANUAL' %></div><h1><%= editing ? 'Edit transaksi' : 'Tambah transaksi' %></h1><p><%= editing ? 'Perbarui informasi transaksi Anda.' : 'Catat detail pemasukan atau pengeluaran Anda.' %></p></div>
  <a class="button ghost" href="<%= editing ? `/transaksi/${transaction.id}` : '/transaksi' %>">← Kembali</a>
</div>
<div class="form-layout">
  <form method="post" action="<%= editing ? `/transaksi/${transaction.id}/edit` : '/transaksi/tambah' %>" class="panel form-panel">
    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
    <div class="panel-heading"><div><h2>Detail transaksi</h2><p>Isi informasi transaksi dengan lengkap.</p></div><span class="step-badge"><%= editing ? formatTransactionReference(transaction.id) : '01' %></span></div>
    <label>Jenis transaksi
      <div class="kind-choice">
        <label class="choice income-choice"><input type="radio" name="kind" value="income" <%= !editing || transaction.kind === 'income' ? 'checked' : '' %>><span class="choice-box"><b>↓</b><span><strong>Pemasukan</strong><small>Uang masuk</small></span></span></label>
        <label class="choice expense-choice"><input type="radio" name="kind" value="expense" <%= editing && transaction.kind === 'expense' ? 'checked' : '' %>><span class="choice-box"><b>↑</b><span><strong>Pengeluaran</strong><small>Uang keluar</small></span></span></label>
      </div>
    </label>
    <label>Nominal transaksi<div class="money-input"><span>Rp</span><input name="amount" type="number" min="1" step="1" placeholder="0" value="<%= editing ? transaction.amount : '' %>" required></div></label>
    <div class="input-row"><label>Kategori<input name="category" type="text" placeholder="Contoh: Gaji, Makanan" maxlength="80" value="<%= editing ? transaction.category : '' %>" required></label><label>Tanggal<input name="happened_on" type="date" value="<%= editing ? new Date(transaction.happened_on).toLocaleDateString('en-CA',{timeZone:'Asia/Jakarta'}) : new Date().toLocaleDateString('en-CA',{timeZone:'Asia/Jakarta'}) %>" required></label></div>
    <label>Catatan <span class="optional">opsional</span><textarea name="note" rows="3" maxlength="240" placeholder="Tambahkan keterangan transaksi..."><%= editing ? transaction.note || '' : '' %></textarea></label>
    <div class="form-actions"><a class="button ghost" href="<%= editing ? `/transaksi/${transaction.id}` : '/transaksi' %>">Batal</a><button class="button primary"><%= editing ? 'Simpan perubahan' : 'Simpan transaksi' %> <span>→</span></button></div>
  </form>
  <aside class="panel tip-panel"><div class="tip-icon">✦</div><h3><%= editing ? 'Periksa kembali perubahan' : 'Pencatatan yang konsisten' %></h3><p><%= editing ? 'Perubahan nominal, jenis, atau tanggal akan langsung tercermin pada dashboard dan laporan.' : 'Catat transaksi segera setelah terjadi agar laporan keuangan Anda tetap akurat.' %></p><div class="tip-rule"></div><div class="tip-item"><span>01</span><p>Pilih jenis transaksi yang tepat.</p></div><div class="tip-item"><span>02</span><p>Gunakan kategori untuk memudahkan analisis.</p></div><div class="tip-item"><span>03</span><p>Tambahkan catatan untuk konteks tambahan.</p></div></aside>
</div>
<%- include('partials/footer') %>
