<%- include('partials/header') %>

<div class="row g-7">
  <!--begin::Form Column-->
  <div class="col-lg-8">
    <div class="card card-flush shadow-sm">
      <div class="card-header align-items-center py-5">
        <div class="card-title">
          <div>
            <h2 class="fs-4 fw-bolder text-gray-900 mb-0"><%= editing ? 'Edit Transaksi' : 'Tambah Transaksi Baru' %></h2>
            <span class="fs-7 text-muted fw-bold"><%= editing ? 'Perbarui informasi transaksi keuangan Anda.' : 'Catat detail pemasukan atau pengeluaran secara manual.' %></span>
          </div>
        </div>
        <div class="card-toolbar">
          <span class="badge badge-light-primary fw-bolder fs-7 px-3 py-2">
            <%= editing ? formatTransactionReference(transaction.id) : 'Baru' %>
          </span>
        </div>
      </div>

      <form method="post" action="<%= editing ? `/transaksi/${transaction.id}/edit` : '/transaksi/tambah' %>" class="form">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>" />

        <div class="card-body pt-0">
          <!--begin::Jenis Transaksi-->
          <div class="mb-7">
            <label class="required fs-6 fw-bold mb-3 d-block">Jenis Transaksi</label>
            <div class="row g-4">
              <div class="col-sm-6">
                <label class="mykas-radio-card income-card">
                  <input type="radio" name="kind" value="income" <%= !editing || transaction.kind === 'income' ? 'checked' : '' %> />
                  <div class="d-flex align-items-center">
                    <div class="symbol symbol-40px symbol-light-success me-3">
                      <span class="symbol-label">
                        <span class="svg-icon svg-icon-2 svg-icon-success">
                          <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none">
                            <rect opacity="0.5" x="11" y="18" width="13" height="2" rx="1" transform="rotate(-90 11 18)" fill="currentColor"/>
                            <path d="M11.4343 15.4343L7.25 11.25C6.83579 10.8358 6.16421 10.8358 5.75 11.25C5.33579 11.6642 5.33579 12.3358 5.75 12.75L11.2929 18.2929C11.6834 18.6834 12.3166 18.6834 12.7071 18.2929L18.25 12.75C18.6642 12.3358 18.6642 11.6642 18.25 11.25L12.5657 15.4343C12.2533 15.7467 11.7467 15.7467 11.4343 15.4343Z" fill="currentColor"/>
                          </svg>
                        </span>
                      </span>
                    </div>
                    <div>
                      <div class="fw-bolder fs-6 text-gray-900">Pemasukan</div>
                      <div class="text-muted fs-7">Uang masuk ke kas</div>
                    </div>
                  </div>
                </label>
              </div>

              <div class="col-sm-6">
                <label class="mykas-radio-card expense-card">
                  <input type="radio" name="kind" value="expense" <%= editing && transaction.kind === 'expense' ? 'checked' : '' %> />
                  <div class="d-flex align-items-center">
                    <div class="symbol symbol-40px symbol-light-danger me-3">
                      <span class="symbol-label">
                        <span class="svg-icon svg-icon-2 svg-icon-danger">
                          <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none">
                            <rect opacity="0.5" x="13" y="6" width="13" height="2" rx="1" transform="rotate(90 13 6)" fill="currentColor"/>
                            <path d="M12.5657 8.56569L16.75 12.75C17.1642 13.1642 17.8358 13.1642 18.25 12.75C18.6642 12.3358 18.6642 11.6642 18.25 11.25L12.7071 5.70711C12.3166 5.31658 11.6834 5.31658 11.2929 5.70711L5.75 11.25C5.33579 11.6642 5.33579 12.3358 5.75 12.75C6.16421 13.1642 6.83579 13.1642 7.25 12.75L11.4343 8.56569C11.7467 8.25327 12.2533 8.25327 12.5657 8.56569Z" fill="currentColor"/>
                          </svg>
                        </span>
                      </span>
                    </div>
                    <div>
                      <div class="fw-bolder fs-6 text-gray-900">Pengeluaran</div>
                      <div class="text-muted fs-7">Uang keluar dari kas</div>
                    </div>
                  </div>
                </label>
              </div>
            </div>
          </div>
          <!--end::Jenis Transaksi-->

          <!--begin::Nominal-->
          <div class="fv-row mb-7">
            <label class="required fs-6 fw-bold mb-2">Nominal Transaksi</label>
            <div class="input-group input-group-solid">
              <span class="input-group-text fw-bolder fs-6 text-gray-700">Rp</span>
              <input type="number" min="1" step="1" name="amount" class="form-control form-control-solid fs-5 fw-bolder" placeholder="0" value="<%= editing ? transaction.amount : '' %>" required />
            </div>
          </div>
          <!--end::Nominal-->

          <!--begin::Kategori & Tanggal-->
          <div class="row g-4 mb-7">
            <div class="col-sm-6">
              <label class="required fs-6 fw-bold mb-2">Kategori</label>
              <input type="text" name="category" class="form-control form-control-solid" placeholder="Contoh: Gaji, Makanan, Transport" maxlength="80" value="<%= editing ? transaction.category : '' %>" required />
            </div>
            <div class="col-sm-6">
              <label class="required fs-6 fw-bold mb-2">Tanggal Transaksi</label>
              <input type="date" name="happened_on" class="form-control form-control-solid" value="<%= editing ? new Date(transaction.happened_on).toLocaleDateString('en-CA',{timeZone:'Asia/Jakarta'}) : new Date().toLocaleDateString('en-CA',{timeZone:'Asia/Jakarta'}) %>" required />
            </div>
          </div>
          <!--end::Kategori & Tanggal-->

          <!--begin::Catatan-->
          <div class="fv-row mb-4">
            <label class="fs-6 fw-bold mb-2">Catatan <span class="text-muted fw-normal fs-7">(opsional)</span></label>
            <textarea name="note" class="form-control form-control-solid" rows="3" maxlength="240" placeholder="Tambahkan keterangan atau rincian transaksi..."><%= editing ? transaction.note || '' : '' %></textarea>
          </div>
          <!--end::Catatan-->
        </div>

        <div class="card-footer d-flex justify-content-end py-6 px-9 gap-3">
          <a href="<%= editing ? `/transaksi/${transaction.id}` : '/transaksi' %>" class="btn btn-light">Batal</a>
          <button type="submit" class="btn btn-primary fw-bolder"><%= editing ? 'Simpan Perubahan' : 'Simpan Transaksi' %></button>
        </div>
      </form>
    </div>
  </div>
  <!--end::Form Column-->

  <!--begin::Info Column-->
  <div class="col-lg-4">
    <div class="card card-flush bg-light-primary border border-primary border-dashed shadow-sm">
      <div class="card-body p-7">
        <div class="d-flex align-items-center mb-5">
          <div class="symbol symbol-40px symbol-light-primary me-3">
            <span class="symbol-label">
              <span class="svg-icon svg-icon-2 svg-icon-primary">
                <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none">
                  <path opacity="0.3" d="M12 22C17.5228 22 22 17.5228 22 12C22 6.47715 17.5228 2 12 2C6.47715 2 2 6.47715 2 12C2 17.5228 6.47715 22 12 22Z" fill="currentColor"/>
                  <path d="M10.8 16C10.6 16 10.4 15.9 10.3 15.7L7.3 12.7C7 12.4 7 11.9 7.3 11.6C7.6 11.3 8.1 11.3 8.4 11.6L10.8 14L15.6 9.2C15.9 8.9 16.4 8.9 16.7 9.2C17 9.5 17 10 16.7 10.3L11.3 15.7C11.2 15.9 11 16 10.8 16Z" fill="currentColor"/>
                </svg>
              </span>
            </span>
          </div>
          <h3 class="fs-5 fw-bolder text-gray-900 mb-0">
            <%= editing ? 'Pemeriksaan Perubahan' : 'Tips Pencatatan' %>
          </h3>
        </div>

        <p class="fs-7 text-gray-600 mb-5 lh-base">
          <%= editing 
            ? 'Setiap perubahan nominal, jenis, atau tanggal akan secara otomatis memperbarui saldo dompet aktif, kartu statistik dashboard, serta ringkasan laporan.' 
            : 'Catat transaksi segera setelah terjadi agar catatan keuangan Anda selalu mencerminkan kondisi saldo terkini.' 
          %>
        </p>

        <div class="separator separator-dashed border-primary opacity-25 my-5"></div>

        <div class="d-flex flex-column gap-3">
          <div class="d-flex align-items-center">
            <span class="badge badge-light-primary fw-bolder me-3">01</span>
            <span class="fs-7 text-gray-700 fw-bold">Pilih jenis (Pemasukan / Pengeluaran)</span>
          </div>
          <div class="d-flex align-items-center">
            <span class="badge badge-light-primary fw-bolder me-3">02</span>
            <span class="fs-7 text-gray-700 fw-bold">Tentukan kategori yang konsisten</span>
          </div>
          <div class="d-flex align-items-center">
            <span class="badge badge-light-primary fw-bolder me-3">03</span>
            <span class="fs-7 text-gray-700 fw-bold">Sertakan catatan rincian jika perlu</span>
          </div>
        </div>
      </div>
    </div>
  </div>
  <!--end::Info Column-->
</div>

<%- include('partials/footer') %>
