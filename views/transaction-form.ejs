<%- include('partials/header') %>
<div class="mx-auto max-w-6xl space-y-7 px-5 py-8 sm:px-8 lg:px-10"><section class="flex items-end justify-between gap-4"><div><p class="text-sm font-bold uppercase tracking-[.18em] text-indigo-600 dark:text-indigo-300"><%= editing ? 'Perubahan pencatatan' : 'Pencatatan manual' %></p><h1 class="mt-2 text-3xl font-bold tracking-tight text-slate-900 dark:text-white"><%= editing ? 'Edit transaksi' : 'Tambah transaksi' %></h1><p class="mt-2 text-base text-slate-600 dark:text-slate-300"><%= editing ? 'Perbarui informasi transaksi Anda.' : 'Catat detail pemasukan atau pengeluaran Anda.' %></p></div><a class="rounded-xl border border-slate-300 px-4 py-2.5 text-sm font-bold text-slate-700 hover:bg-slate-100 dark:border-slate-700 dark:text-slate-200 dark:hover:bg-slate-800" href="<%= editing ? `/transaksi/${transaction.id}` : '/transaksi' %>">← Kembali</a></section>
<div class="grid gap-6 lg:grid-cols-[minmax(0,1fr)_19rem]"><form method="post" action="<%= editing ? `/transaksi/${transaction.id}/edit` : '/transaksi/tambah' %>" class="space-y-6 rounded-2xl border border-slate-200 bg-white p-5 shadow-sm dark:border-slate-700 dark:bg-slate-800 sm:p-7"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><div class="flex items-center justify-between border-b border-slate-200 pb-4 dark:border-slate-700"><div><h2 class="font-bold text-slate-900 dark:text-white">Detail transaksi</h2><p class="mt-1 text-sm text-slate-600 dark:text-slate-300">Isi informasi transaksi dengan lengkap.</p></div><span class="rounded-lg bg-indigo-50 px-3 py-2 text-xs font-bold text-indigo-700 dark:bg-indigo-900/40 dark:text-indigo-200"><%= editing ? formatTransactionReference(transaction.id) : '01' %></span></div>
<fieldset><legend class="mb-2 text-sm font-semibold text-slate-700 dark:text-slate-200">Jenis transaksi</legend><div class="grid gap-3 sm:grid-cols-2"><label class="flex cursor-pointer items-center gap-3 rounded-xl border border-emerald-200 p-4 has-[:checked]:bg-emerald-50 has-[:checked]:ring-2 has-[:checked]:ring-emerald-500 dark:border-emerald-900 dark:has-[:checked]:bg-emerald-950/40"><input class="h-4 w-4 accent-emerald-600" type="radio" name="kind" value="income" <%= !editing || transaction.kind === 'income' ? 'checked' : '' %>><span><strong class="block text-sm text-slate-900 dark:text-white">Pemasukan</strong><small class="text-sm text-slate-600 dark:text-slate-300">Uang masuk</small></span></label><label class="flex cursor-pointer items-center gap-3 rounded-xl border border-rose-200 p-4 has-[:checked]:bg-rose-50 has-[:checked]:ring-2 has-[:checked]:ring-rose-500 dark:border-rose-900 dark:has-[:checked]:bg-rose-950/40"><input class="h-4 w-4 accent-rose-600" type="radio" name="kind" value="expense" <%= editing && transaction.kind === 'expense' ? 'checked' : '' %>><span><strong class="block text-sm text-slate-900 dark:text-white">Pengeluaran</strong><small class="text-sm text-slate-600 dark:text-slate-300">Uang keluar</small></span></label></div></fieldset>
<label class="block text-sm font-semibold text-slate-700 dark:text-slate-200">Nominal transaksi<div class="mt-2 flex h-12 items-center rounded-xl border border-slate-300 bg-white focus-within:border-indigo-500 focus-within:ring-4 focus-within:ring-indigo-500/15 dark:border-slate-600 dark:bg-slate-900"><span class="border-r border-slate-200 px-4 text-sm font-bold text-slate-500 dark:border-slate-700">Rp</span><input class="min-w-0 flex-1 rounded-r-xl bg-transparent px-4 text-base font-semibold text-slate-900 outline-none dark:text-white" name="amount" type="number" min="1" step="1" placeholder="0" value="<%= editing ? transaction.amount : '' %>" required></div></label>
<div class="grid gap-5 sm:grid-cols-2"><label class="block text-sm font-semibold text-slate-700 dark:text-slate-200">Kategori<input class="mt-2 block h-12 w-full rounded-xl border border-slate-300 bg-white px-4 text-sm text-slate-900 outline-none focus:border-indigo-500 focus:ring-4 focus:ring-indigo-500/15 dark:border-slate-600 dark:bg-slate-900 dark:text-white" name="category" type="text" placeholder="Contoh: Gaji, Makanan" maxlength="80" value="<%= editing ? transaction.category : '' %>" required></label><label class="block text-sm font-semibold text-slate-700 dark:text-slate-200">Tanggal<input class="mt-2 block h-12 w-full rounded-xl border border-slate-300 bg-white px-4 text-sm text-slate-900 outline-none focus:border-indigo-500 focus:ring-4 focus:ring-indigo-500/15 dark:border-slate-600 dark:bg-slate-900 dark:text-white" name="happened_on" type="date" value="<%= editing ? new Date(transaction.happened_on).toLocaleDateString('en-CA',{timeZone:'Asia/Jakarta'}) : new Date().toLocaleDateString('en-CA',{timeZone:'Asia/Jakarta'}) %>" required></label></div>
<label class="block text-sm font-semibold text-slate-700 dark:text-slate-200">Catatan <span class="font-normal text-slate-500">(opsional)</span><textarea class="mt-2 block w-full rounded-xl border border-slate-300 bg-white px-4 py-3 text-sm text-slate-900 outline-none focus:border-indigo-500 focus:ring-4 focus:ring-indigo-500/15 dark:border-slate-600 dark:bg-slate-900 dark:text-white" name="note" rows="3" maxlength="240" placeholder="Tambahkan keterangan transaksi..."><%= editing ? transaction.note || '' : '' %></textarea></label><div class="flex flex-wrap justify-end gap-3 border-t border-slate-200 pt-5 dark:border-slate-700"><a class="rounded-xl border border-slate-300 px-5 py-3 text-sm font-bold text-slate-700 hover:bg-slate-50 dark:border-slate-600 dark:text-slate-200 dark:hover:bg-slate-700" href="<%= editing ? `/transaksi/${transaction.id}` : '/transaksi' %>">Batal</a><button class="rounded-xl bg-indigo-600 px-5 py-3 text-sm font-bold text-white hover:bg-indigo-700"><%= editing ? 'Simpan perubahan' : 'Simpan transaksi' %></button></div></form>
<aside class="h-fit rounded-2xl border border-indigo-100 bg-indigo-50 p-5 dark:border-indigo-900/60 dark:bg-indigo-950/40"><span class="grid h-10 w-10 place-items-center rounded-xl bg-white text-lg text-indigo-700 shadow-sm dark:bg-slate-800 dark:text-indigo-300">✦</span><h2 class="mt-4 font-bold text-slate-900 dark:text-white"><%= editing ? 'Periksa kembali perubahan' : 'Pencatatan yang konsisten' %></h2><p class="mt-2 text-sm leading-6 text-slate-600 dark:text-slate-300"><%= editing ? 'Perubahan nominal, jenis, atau tanggal akan langsung tercermin pada dashboard dan laporan.' : 'Catat transaksi segera setelah terjadi agar laporan keuangan Anda tetap akurat.' %></p><ol class="mt-5 space-y-3 border-t border-indigo-200 pt-4 text-sm text-slate-700 dark:border-indigo-900 dark:text-slate-200"><li><strong class="mr-2 text-indigo-700 dark:text-indigo-300">01</strong>Pilih jenis transaksi.</li><li><strong class="mr-2 text-indigo-700 dark:text-indigo-300">02</strong>Gunakan kategori yang konsisten.</li><li><strong class="mr-2 text-indigo-700 dark:text-indigo-300">03</strong>Tambahkan catatan bila perlu.</li></ol></aside></div></div>
<%- include('partials/footer') %>
