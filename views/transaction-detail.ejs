<%- include('partials/header') %>
<div class="page-heading"><div><div class="eyebrow">RIWAYAT PENCATATAN</div><h1>Detail transaksi</h1><p>Informasi lengkap untuk transaksi yang dipilih.</p></div><a class="button ghost" href="/transaksi">← Kembali ke transaksi</a></div>
<div class="detail-layout"><section class="panel detail-panel"><div class="detail-top"><span class="type-pill <%= transaction.kind %>"><%= transaction.kind === 'income' ? 'Pemasukan' : 'Pengeluaran' %></span><span class="source-label">Dicatat melalui <%= transaction.source === 'whatsapp' ? 'WhatsApp' : 'dashboard' %></span></div><div class="detail-amount <%= transaction.kind %>"><%= transaction.kind === 'income' ? '+' : '−' %> <%= formatRupiah(transaction.amount) %></div><div class="detail-reference"><span>ID TRANSAKSI</span><strong><%= formatTransactionReference(transaction.id,transaction.happened_on) %></strong></div><div class="detail-grid"><div><span>Tanggal transaksi</span><strong><%= formatDate(transaction.happened_on) %></strong></div><div><span>Kategori</span><strong><%= transaction.category %></strong></div><div><span>Waktu dicatat</span><strong><%= formatDate(transaction.created_at) %></strong></div><div><span>Nomor database</span><strong>#<%= transaction.id %></strong></div><div class="detail-note"><span>Catatan</span><strong><%= transaction.note || 'Tidak ada catatan tambahan' %></strong></div></div></section><aside class="panel detail-side"><div class="tip-icon">✓</div><h3>Transaksi tersimpan</h3><p>ID ini dapat digunakan untuk merujuk transaksi saat melihat riwayat atau menghubungi admin.</p><a class="button secondary" href="/laporan">Lihat laporan</a></aside></div>
<%- include('partials/footer') %>
