<%- include('partials/header') %>
<div class="mx-auto max-w-5xl space-y-7 px-5 py-8 sm:px-8 lg:px-10"><section class="flex flex-col gap-4 sm:flex-row sm:items-end sm:justify-between"><div><p class="text-sm font-bold uppercase tracking-[.18em] text-indigo-600 dark:text-indigo-300">Riwayat pencatatan</p><h1 class="mt-2 text-3xl font-bold tracking-tight text-slate-900 dark:text-white">Detail transaksi</h1><p class="mt-2 text-base text-slate-600 dark:text-slate-300">Informasi lengkap untuk transaksi yang dipilih.</p></div><div class="flex gap-2"><a class="rounded-xl bg-indigo-600 px-4 py-2.5 text-sm font-bold text-white hover:bg-indigo-700" href="/transaksi/<%= transaction.id %>/edit">Edit transaksi</a><a class="rounded-xl border border-slate-300 px-4 py-2.5 text-sm font-bold text-slate-700 hover:bg-slate-100 dark:border-slate-700 dark:text-slate-200 dark:hover:bg-slate-800" href="/transaksi">Kembali</a></div></section>
<section class="overflow-hidden rounded-3xl border border-slate-200 bg-white shadow-sm dark:border-slate-700 dark:bg-slate-800"><div class="border-b border-slate-200 bg-slate-50 p-6 dark:border-slate-700 dark:bg-slate-900/50 sm:p-8"><div class="flex flex-wrap items-center justify-between gap-3"><span class="rounded-full px-3 py-1.5 text-sm font-bold <%= transaction.kind === 'income' ? 'bg-emerald-100 text-emerald-800 dark:bg-emerald-900/50 dark:text-emerald-200' : 'bg-rose-100 text-rose-800 dark:bg-rose-900/50 dark:text-rose-200' %>"><%= transaction.kind === 'income' ? 'Pemasukan' : 'Pengeluaran' %></span><span class="text-sm font-semibold text-slate-600 dark:text-slate-300">Dicatat melalui <%= transaction.source === 'whatsapp' ? 'WhatsApp' : 'dashboard' %></span></div><p class="mt-6 text-3xl font-bold tracking-tight <%= transaction.kind === 'income' ? 'text-emerald-700 dark:text-emerald-300' : 'text-rose-700 dark:text-rose-300' %>"><%= transaction.kind === 'income' ? '+' : '−' %> <%= formatRupiah(transaction.amount) %></p><p class="mt-3 text-sm font-semibold text-slate-600 dark:text-slate-300">ID transaksi · <span class="font-mono text-slate-900 dark:text-white"><%= formatTransactionReference(transaction.id) %></span></p></div><dl class="grid gap-0 sm:grid-cols-2"><div class="border-b border-slate-100 p-6 dark:border-slate-700 sm:border-r"><dt class="text-sm font-semibold text-slate-500 dark:text-slate-400">Tanggal transaksi</dt><dd class="mt-2 text-base font-bold text-slate-900 dark:text-white"><%= formatDate(transaction.happened_on) %></dd></div><div class="border-b border-slate-100 p-6 dark:border-slate-700"><dt class="text-sm font-semibold text-slate-500 dark:text-slate-400">Kategori</dt><dd class="mt-2 text-base font-bold text-slate-900 dark:text-white"><%= transaction.category %></dd></div><div class="border-b border-slate-100 p-6 dark:border-slate-700 sm:border-r"><dt class="text-sm font-semibold text-slate-500 dark:text-slate-400">Dompet</dt><dd class="mt-2 text-base font-bold text-slate-900 dark:text-white"><%= transaction.wallet_name || 'Belum ditetapkan' %></dd></div><div class="border-b border-slate-100 p-6 dark:border-slate-700"><dt class="text-sm font-semibold text-slate-500 dark:text-slate-400">Waktu dicatat</dt><dd class="mt-2 text-base font-bold text-slate-900 dark:text-white"><%= formatDate(transaction.created_at) %></dd></div><div class="p-6 sm:col-span-2"><dt class="text-sm font-semibold text-slate-500 dark:text-slate-400">Catatan</dt><dd class="mt-2 whitespace-pre-wrap text-base font-medium leading-7 text-slate-800 dark:text-slate-100"><%= transaction.note || 'Tidak ada catatan tambahan.' %></dd></div></dl></section><p class="text-sm leading-6 text-slate-600 dark:text-slate-300">ID transaksi dapat digunakan untuk merujuk catatan ini saat melihat riwayat atau menghubungi administrator.</p></div>
<%- include('partials/footer') %>
