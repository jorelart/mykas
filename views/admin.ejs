<%- include('partials/header') %>
<div class="mx-auto max-w-7xl space-y-7 px-5 py-8 sm:px-8 lg:px-10"><section><p class="text-sm font-bold uppercase tracking-[.18em] text-indigo-600 dark:text-indigo-300">Panel administrator</p><h1 class="mt-2 text-3xl font-bold tracking-tight text-slate-900 dark:text-white sm:text-4xl">Ringkasan sistem</h1><p class="mt-2 text-base text-slate-600 dark:text-slate-300">Kelola akun dan pantau aktivitas keuangan MyKas.</p></section>
<section class="grid gap-4 sm:grid-cols-2 xl:grid-cols-4"><% const stats = [{label:'Total pengguna',value:users.total,sub:'Semua akun terdaftar',color:'indigo'},{label:'Terverifikasi',value:users.verified,sub:'Aktivasi WhatsApp selesai',color:'emerald'},{label:'Ditangguhkan',value:users.suspended,sub:'Tidak dapat masuk',color:'amber'},{label:'Total transaksi',value:transactions.total,sub:'Semua akun',color:'violet'}]; stats.forEach(stat => { %><article class="rounded-2xl border border-slate-200 bg-white p-5 shadow-sm dark:border-slate-700 dark:bg-slate-800"><p class="text-sm font-semibold text-slate-600 dark:text-slate-300"><%= stat.label %></p><p class="mt-3 text-3xl font-bold tracking-tight text-slate-900 dark:text-white"><%= stat.value %></p><p class="mt-2 text-sm text-slate-500 dark:text-slate-400"><%= stat.sub %></p></article><% }) %></section>
<section class="overflow-hidden rounded-2xl border border-slate-200 bg-white shadow-sm dark:border-slate-700 dark:bg-slate-800"><div class="border-b border-slate-200 px-5 py-4 dark:border-slate-700"><h2 class="font-bold text-slate-900 dark:text-white">Manajemen pengguna</h2><p class="mt-1 text-sm text-slate-600 dark:text-slate-300">Tangguhkan atau aktifkan akun, dan kirim instruksi reset kata sandi ke WhatsApp.</p></div><% if (recentUsers.length) { %><div class="overflow-x-auto"><table class="min-w-full divide-y divide-slate-200 text-left dark:divide-slate-700"><thead class="bg-slate-50 dark:bg-slate-900/60"><tr><th class="px-5 py-3 text-xs font-bold uppercase tracking-wider text-slate-600 dark:text-slate-300">Pengguna</th><th class="px-5 py-3 text-xs font-bold uppercase tracking-wider text-slate-600 dark:text-slate-300">Status</th><th class="px-5 py-3 text-xs font-bold uppercase tracking-wider text-slate-600 dark:text-slate-300">Tanggal daftar</th><th class="px-5 py-3 text-xs font-bold uppercase tracking-wider text-slate-600 dark:text-slate-300">Aksi akun</th></tr></thead><tbody class="divide-y divide-slate-100 dark:divide-slate-700"><% recentUsers.forEach(account => { const isCurrentAdmin = Number(account.id) === Number(user.id); %><tr class="align-top hover:bg-slate-50 dark:hover:bg-slate-700/30"><td class="px-5 py-4"><strong class="block text-sm font-bold text-slate-900 dark:text-white"><%= account.name %></strong><span class="mt-1 block text-sm text-slate-600 dark:text-slate-300"><%= account.email %></span></td><td class="whitespace-nowrap px-5 py-4"><% if (account.is_suspended) { %><span class="rounded-full bg-amber-100 px-3 py-1.5 text-xs font-bold text-amber-900 dark:bg-amber-900/50 dark:text-amber-200">Ditangguhkan</span><% } else if (account.is_verified) { %><span class="rounded-full bg-emerald-100 px-3 py-1.5 text-xs font-bold text-emerald-900 dark:bg-emerald-900/50 dark:text-emerald-200">Terverifikasi</span><% } else { %><span class="rounded-full bg-slate-100 px-3 py-1.5 text-xs font-bold text-slate-700 dark:bg-slate-700 dark:text-slate-200">Menunggu aktivasi</span><% } %></td><td class="whitespace-nowrap px-5 py-4 text-sm font-medium text-slate-700 dark:text-slate-200"><%= formatDate(account.created_at) %></td><td class="px-5 py-4"><div class="flex min-w-48 flex-col items-start gap-2"><form method="post" action="/admin/users/<%= account.id %>/suspension"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="suspended" value="<%= account.is_suspended ? '0' : '1' %>"><button class="rounded-lg border px-3 py-2 text-xs font-bold transition <%= account.is_suspended ? 'border-emerald-200 text-emerald-800 hover:bg-emerald-50 dark:border-emerald-900 dark:text-emerald-200 dark:hover:bg-emerald-950' : 'border-amber-200 text-amber-900 hover:bg-amber-50 dark:border-amber-900 dark:text-amber-200 dark:hover:bg-amber-950' %>" <%= isCurrentAdmin ? 'disabled title="Akun admin aktif tidak dapat ditangguhkan"' : '' %>><%= account.is_suspended ? 'Aktifkan akun' : 'Suspend akun' %></button></form><form method="post" action="/admin/users/<%= account.id %>/reset-password"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="rounded-lg bg-indigo-600 px-3 py-2 text-xs font-bold text-white hover:bg-indigo-700" <%= !account.is_verified ? 'disabled title="Akun belum terverifikasi"' : '' %>>Kirim reset password</button></form></div></td></tr><% }) %></tbody></table></div><% } else { %><div class="p-8 text-center text-sm text-slate-600 dark:text-slate-300">Belum ada akun pengguna.</div><% } %><div class="flex flex-wrap items-center justify-between gap-3 border-t border-slate-200 px-5 py-3 dark:border-slate-700"><p class="text-xs font-medium text-slate-500 dark:text-slate-400">Halaman <%= usersPage %> dari <%= usersPages %> · pengguna terbaru</p><nav class="flex gap-2" aria-label="Halaman pengguna"><% if (usersPage > 1) { %><a class="rounded-lg border border-slate-300 px-3 py-2 text-xs font-bold text-slate-700 hover:bg-slate-50 dark:border-slate-600 dark:text-slate-200 dark:hover:bg-slate-700" href="/admin?users_page=<%= usersPage - 1 %>">Sebelumnya</a><% } %><% if (usersPage < usersPages) { %><a class="rounded-lg border border-slate-300 px-3 py-2 text-xs font-bold text-slate-700 hover:bg-slate-50 dark:border-slate-600 dark:text-slate-200 dark:hover:bg-slate-700" href="/admin?users_page=<%= usersPage + 1 %>">Berikutnya</a><% } %></nav></div></section>
<section class="overflow-hidden rounded-2xl border border-slate-200 bg-white shadow-sm dark:border-slate-700 dark:bg-slate-800"><div class="border-b border-slate-200 px-5 py-4 dark:border-slate-700"><h2 class="font-bold text-slate-900 dark:text-white">Transaksi terbaru</h2><p class="mt-1 text-sm text-slate-600 dark:text-slate-300">Aktivitas dari seluruh akun.</p></div><% if (recentTransactions.length) { %><div class="overflow-x-auto"><table class="min-w-full divide-y divide-slate-200 text-left dark:divide-slate-700"><thead class="bg-slate-50 dark:bg-slate-900/60"><tr><th class="px-5 py-3 text-xs font-bold uppercase tracking-wider text-slate-600 dark:text-slate-300">ID</th><th class="px-5 py-3 text-xs font-bold uppercase tracking-wider text-slate-600 dark:text-slate-300">Pengguna</th><th class="px-5 py-3 text-xs font-bold uppercase tracking-wider text-slate-600 dark:text-slate-300">Kategori</th><th class="px-5 py-3 text-xs font-bold uppercase tracking-wider text-slate-600 dark:text-slate-300">Tanggal</th><th class="px-5 py-3 text-xs font-bold uppercase tracking-wider text-slate-600 dark:text-slate-300">Jenis</th><th class="px-5 py-3 text-right text-xs font-bold uppercase tracking-wider text-slate-600 dark:text-slate-300">Nominal</th></tr></thead><tbody class="divide-y divide-slate-100 dark:divide-slate-700"><% recentTransactions.forEach(tx => { %><tr><td class="whitespace-nowrap px-5 py-4 text-sm font-bold text-indigo-700 dark:text-indigo-300"><%= formatTransactionReference(tx.id,tx.happened_on) %></td><td class="px-5 py-4"><strong class="block text-sm font-bold text-slate-900 dark:text-white"><%= tx.user_name %></strong><span class="text-sm text-slate-600 dark:text-slate-300"><%= tx.user_email %></span></td><td class="whitespace-nowrap px-5 py-4 text-sm font-medium text-slate-700 dark:text-slate-200"><%= tx.category %></td><td class="whitespace-nowrap px-5 py-4 text-sm font-medium text-slate-700 dark:text-slate-200"><%= formatDate(tx.happened_on) %></td><td class="whitespace-nowrap px-5 py-4 text-sm font-semibold text-slate-700 dark:text-slate-200"><%= tx.kind === 'income' ? 'Pemasukan' : 'Pengeluaran' %></td><td class="whitespace-nowrap px-5 py-4 text-right text-sm font-bold <%= tx.kind === 'income' ? 'text-emerald-700 dark:text-emerald-300' : 'text-rose-700 dark:text-rose-300' %>"><%= formatRupiah(tx.amount) %></td></tr><% }) %></tbody></table></div><% } else { %><div class="p-8 text-center text-sm text-slate-600 dark:text-slate-300">Belum ada transaksi.</div><% } %></section></div>
<%- include('partials/footer') %>
