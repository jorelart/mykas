<%- include('partials/header') %>
<div class="page-heading"><div><div class="eyebrow">PANEL ADMINISTRATOR</div><h1>Ringkasan sistem</h1><p>Pantau akun dan transaksi yang tercatat di MyKas.</p></div><span class="admin-badge">ADMIN</span></div>
<div class="stats-grid admin-stats"><article class="stat-card"><div class="stat-top"><span>Total pengguna</span><span class="stat-icon indigo">♙</span></div><strong class="stat-value"><%= users.total %></strong><div class="stat-caption">Semua akun terdaftar</div></article><article class="stat-card"><div class="stat-top"><span>Akun terverifikasi</span><span class="stat-icon green">✓</span></div><strong class="stat-value"><%= users.verified %></strong><div class="stat-caption">Aktivasi WhatsApp selesai</div></article><article class="stat-card"><div class="stat-top"><span>Total transaksi</span><span class="stat-icon violet">≋</span></div><strong class="stat-value"><%= transactions.total %></strong><div class="stat-caption">Semua akun</div></article><article class="stat-card"><div class="stat-top"><span>Nilai bersih tercatat</span><span class="stat-icon orange">◈</span></div><strong class="stat-value"><%= formatRupiah(Number(transactions.income)-Number(transactions.expense)) %></strong><div class="stat-caption">Pemasukan dikurangi pengeluaran</div></article></div>
<div class="section-heading"><div><h2>Transaksi terbaru</h2><p>Aktivitas dari seluruh akun.</p></div></div>
<div class="table-card"><% if (recentTransactions.length) { %><div class="table-scroll"><table><thead><tr><th>ID TRANSAKSI</th><th>PENGGUNA</th><th>KATEGORI</th><th>TANGGAL</th><th>JENIS</th><th class="align-right">NOMINAL</th></tr></thead><tbody><% recentTransactions.forEach(tx => { %><tr><td><span class="reference-link"><%= formatTransactionReference(tx.id,tx.happened_on) %></span></td><td><span class="admin-user"><strong><%= tx.user_name %></strong><small><%= tx.user_email %></small></span></td><td><span class="category-chip"><%= tx.category %></span></td><td><%= formatDate(tx.happened_on) %></td><td><span class="type-pill <%= tx.kind %>"><%= tx.kind === 'income' ? 'Pemasukan' : 'Pengeluaran' %></span></td><td class="align-right amount <%= tx.kind %>"><%= formatRupiah(tx.amount) %></td></tr><% }) %></tbody></table></div><% } else { %><div class="empty-state compact"><strong>Belum ada transaksi</strong></div><% } %></div>
<div class="section-heading"><div><h2>Pengguna terbaru</h2><p>20 akun terakhir yang mendaftar.</p></div></div>
<div class="table-card"><% if (recentUsers.length) { %><div class="table-scroll"><table><thead><tr><th>PENGGUNA</th><th>STATUS</th><th>TANGGAL DAFTAR</th></tr></thead><tbody><% recentUsers.forEach(account => { %><tr><td><span class="admin-user"><strong><%= account.name %></strong><small><%= account.email %></small></span></td><td><span class="type-pill <%= account.is_verified ? 'income' : 'expense' %>"><%= account.is_verified ? 'Terverifikasi' : 'Menunggu aktivasi' %></span></td><td><%= formatDate(account.created_at) %></td></tr><% }) %></tbody></table></div><% } else { %><div class="empty-state compact"><strong>Belum ada akun pengguna</strong></div><% } %></div>
<%- include('partials/footer') %>
