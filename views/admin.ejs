<%- include('partials/header') %>

<!--begin::Stats Widgets-->
<div class="row g-5 g-xl-8 mb-7">
  <div class="col-sm-6 col-xl-3">
    <div class="card card-flush h-100 shadow-sm">
      <div class="card-body d-flex flex-column justify-content-between p-6">
        <div class="d-flex align-items-center mb-3">
          <div class="symbol symbol-45px symbol-light-primary me-4">
            <span class="symbol-label">
              <span class="svg-icon svg-icon-2x svg-icon-primary">
                <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none">
                  <path opacity="0.3" d="M22 12C22 17.5 17.5 22 12 22C6.5 22 2 17.5 2 12C2 6.5 6.5 2 12 2C17.5 2 22 6.5 22 12ZM12 7C10.3 7 9 8.3 9 10C9 11.7 10.3 13 12 13C13.7 13 15 11.7 15 10C15 8.3 13.7 7 12 7Z" fill="currentColor"/>
                  <path d="M12 22C14.6 22 17 21 18.7 19.4C17.9 16.9 15.2 15 12 15C8.8 15 6.09999 16.9 5.29999 19.4C6.99999 21 9.4 22 12 22Z" fill="currentColor"/>
                </svg>
              </span>
            </span>
          </div>
          <div>
            <div class="text-gray-400 fw-bold fs-7">Total Pengguna</div>
            <div class="text-gray-900 fw-bolder fs-2hx lh-1"><%= users.total %></div>
          </div>
        </div>
        <div class="text-muted fs-8">Semua akun terdaftar</div>
      </div>
    </div>
  </div>

  <div class="col-sm-6 col-xl-3">
    <div class="card card-flush h-100 shadow-sm">
      <div class="card-body d-flex flex-column justify-content-between p-6">
        <div class="d-flex align-items-center mb-3">
          <div class="symbol symbol-45px symbol-light-success me-4">
            <span class="symbol-label">
              <span class="svg-icon svg-icon-2x svg-icon-success">
                <path opacity="0.3" d="M10.8 16C10.6 16 10.4 15.9 10.3 15.7L7.3 12.7C7 12.4 7 11.9 7.3 11.6C7.6 11.3 8.1 11.3 8.4 11.6L10.8 14L15.6 9.2C15.9 8.9 16.4 8.9 16.7 9.2C17 9.5 17 10 16.7 10.3L11.3 15.7C11.2 15.9 11 16 10.8 16Z" fill="currentColor"/>
                <path d="M12 22C17.5228 22 22 17.5228 22 12C22 6.47715 17.5228 2 12 2C6.47715 2 2 6.47715 2 12C2 17.5228 6.47715 22 12 22Z" fill="currentColor"/>
              </svg>
            </span>
          </div>
          <div>
            <div class="text-gray-400 fw-bold fs-7">Terverifikasi</div>
            <div class="text-success fw-bolder fs-2hx lh-1"><%= users.verified %></div>
          </div>
        </div>
        <div class="text-muted fs-8">Aktivasi WhatsApp selesai</div>
      </div>
    </div>
  </div>

  <div class="col-sm-6 col-xl-3">
    <div class="card card-flush h-100 shadow-sm">
      <div class="card-body d-flex flex-column justify-content-between p-6">
        <div class="d-flex align-items-center mb-3">
          <div class="symbol symbol-45px symbol-light-warning me-4">
            <span class="symbol-label">
              <span class="svg-icon svg-icon-2x svg-icon-warning">
                <rect opacity="0.3" x="2" y="2" width="20" height="20" rx="10" fill="currentColor"/>
                <rect x="11" y="14" width="7" height="2" rx="1" transform="rotate(-90 11 14)" fill="currentColor"/>
                <rect x="11" y="17" width="2" height="2" rx="1" transform="rotate(-90 11 17)" fill="currentColor"/>
              </svg>
            </span>
          </div>
          <div>
            <div class="text-gray-400 fw-bold fs-7">Ditangguhkan</div>
            <div class="text-warning fw-bolder fs-2hx lh-1"><%= users.suspended %></div>
          </div>
        </div>
        <div class="text-muted fs-8">Akses masuk dibatasi</div>
      </div>
    </div>
  </div>

  <div class="col-sm-6 col-xl-3">
    <div class="card card-flush h-100 shadow-sm">
      <div class="card-body d-flex flex-column justify-content-between p-6">
        <div class="d-flex align-items-center mb-3">
          <div class="symbol symbol-45px symbol-light-primary me-4">
            <span class="symbol-label">
              <span class="svg-icon svg-icon-2x svg-icon-primary">
                <path opacity="0.3" d="M14 3V21H10V3C10 2.4 10.4 2 11 2H13C13.6 2 14 2.4 14 3ZM7 14H5C4.4 14 4 14.4 4 15V21H8V15C8 14.4 7.6 14 7 14Z" fill="currentColor"/>
                <path d="M21 20H20V8C20 7.4 19.6 7 19 7H17C16.4 7 16 7.4 16 8V20H3C2.4 20 2 20.4 2 21C2 21.6 2.4 22 3 22H21C21.6 22 22 21.6 22 21C22 20.4 21.6 20 21 20Z" fill="currentColor"/>
              </svg>
            </span>
          </div>
          <div>
            <div class="text-gray-400 fw-bold fs-7">Total Transaksi</div>
            <div class="text-gray-900 fw-bolder fs-2hx lh-1"><%= transactions.total %></div>
          </div>
        </div>
        <div class="text-muted fs-8">Aktivitas seluruh akun</div>
      </div>
    </div>
  </div>
</div>
<!--end::Stats Widgets-->

<!--begin::Users Management Card-->
<div class="card card-flush shadow-sm mb-7">
  <div class="card-header align-items-center py-5">
    <div class="card-title">
      <div>
        <h2 class="fs-4 fw-bolder text-gray-900 mb-0">Manajemen Pengguna</h2>
        <span class="fs-7 text-muted fw-bold">Tangguhkan atau aktifkan akun pengguna, dan kirim instruksi reset kata sandi</span>
      </div>
    </div>
    <div class="card-toolbar">
      <span class="badge badge-light-primary fw-bolder fs-7 px-3 py-2">
        Halaman <%= usersPage %> dari <%= usersPages %>
      </span>
    </div>
  </div>

  <div class="card-body pt-0">
    <% if (recentUsers.length) { %>
    <div class="table-responsive">
      <table class="table align-middle table-row-dashed fs-6 gy-5" id="kt_admin_users_table">
        <thead>
          <tr class="text-start text-gray-400 fw-bolder fs-7 text-uppercase gs-0">
            <th class="min-w-200px">Pengguna</th>
            <th class="min-w-120px">Status</th>
            <th class="min-w-140px">Tanggal Daftar</th>
            <th class="text-end min-w-200px">Aksi Akun</th>
          </tr>
        </thead>
        <tbody class="fw-bold text-gray-600">
          <% recentUsers.forEach(account => { 
            const isCurrentAdmin = Number(account.id) === Number(user.id);
            const userInitial = String(account.name || 'U').trim().charAt(0).toUpperCase();
          %>
          <tr>
            <td>
              <div class="d-flex align-items-center">
                <div class="symbol symbol-40px symbol-light-primary me-3">
                  <span class="symbol-label fw-bolder fs-5 text-primary"><%= userInitial %></span>
                </div>
                <div class="d-flex flex-column">
                  <span class="text-gray-900 fw-bolder fs-6"><%= account.name %></span>
                  <span class="text-muted fw-bold fs-7"><%= account.email %></span>
                </div>
              </div>
            </td>
            <td>
              <% if (account.is_suspended) { %>
              <span class="badge badge-light-danger fw-bolder fs-7 px-3 py-2">Ditangguhkan</span>
              <% } else if (account.is_verified) { %>
              <span class="badge badge-light-success fw-bolder fs-7 px-3 py-2">Terverifikasi</span>
              <% } else { %>
              <span class="badge badge-light-warning fw-bolder fs-7 px-3 py-2">Menunggu Aktivasi</span>
              <% } %>
            </td>
            <td class="text-gray-600 fw-bold">
              <%= formatDate(account.created_at) %>
            </td>
            <td class="text-end">
              <div class="d-inline-flex gap-2">
                <form method="post" class="<%= account.is_suspended ? '' : 'suspend-confirm-form' %> m-0 d-inline" data-user-name="<%= account.name %>" action="/admin/users/<%= account.id %>/suspension">
                  <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
                  <input type="hidden" name="suspended" value="<%= account.is_suspended ? '0' : '1' %>" />
                  <button type="submit" class="btn btn-sm <%= account.is_suspended ? 'btn-light-success' : 'btn-light-warning' %> fw-bolder" <%= isCurrentAdmin ? 'disabled title="Akun admin saat ini tidak dapat ditangguhkan"' : '' %>>
                    <%= account.is_suspended ? 'Aktifkan' : 'Suspend' %>
                  </button>
                </form>

                <form method="post" action="/admin/users/<%= account.id %>/reset-password" class="m-0 d-inline">
                  <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
                  <button type="submit" class="btn btn-sm btn-light-primary fw-bolder" <%= !account.is_verified ? 'disabled title="Akun belum verifikasi"' : '' %>>
                    Reset Password
                  </button>
                </form>
              </div>
            </td>
          </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
    <% } else { %>
    <div class="text-center py-8 text-muted fs-6">
      Belum ada akun pengguna terdaftar.
    </div>
    <% } %>
  </div>

  <div class="card-footer d-flex justify-content-between align-items-center py-5">
    <span class="text-muted fs-7">
      Menampilkan halaman <%= usersPage %> dari <%= usersPages %>
    </span>
    <div class="d-flex gap-2">
      <% if (usersPage > 1) { %>
      <a href="/admin?users_page=<%= usersPage - 1 %>" class="btn btn-sm btn-light">← Sebelumnya</a>
      <% } %>
      <% if (usersPage < usersPages) { %>
      <a href="/admin?users_page=<%= usersPage + 1 %>" class="btn btn-sm btn-light">Berikutnya →</a>
      <% } %>
    </div>
  </div>
</div>
<!--end::Users Management Card-->

<!--begin::System Transactions Card-->
<div class="card card-flush shadow-sm">
  <div class="card-header align-items-center py-5">
    <div class="card-title">
      <div>
        <h2 class="fs-4 fw-bolder text-gray-900 mb-0">Transaksi Terbaru Sistem</h2>
        <span class="fs-7 text-muted fw-bold">Aktivitas dari seluruh pengguna akun</span>
      </div>
    </div>
  </div>

  <div class="card-body pt-0">
    <% if (recentTransactions.length) { %>
    <div class="table-responsive">
      <table class="table align-middle table-row-dashed fs-6 gy-5" id="kt_admin_transactions_table">
        <thead>
          <tr class="text-start text-gray-400 fw-bolder fs-7 text-uppercase gs-0">
            <th class="min-w-120px">ID Transaksi</th>
            <th class="min-w-180px">Pengguna</th>
            <th class="min-w-120px">Kategori</th>
            <th class="min-w-120px">Tanggal</th>
            <th class="min-w-100px">Jenis</th>
            <th class="text-end min-w-120px">Nominal</th>
          </tr>
        </thead>
        <tbody class="fw-bold text-gray-600">
          <% recentTransactions.forEach(tx => { 
            const isIncome = tx.kind === 'income';
          %>
          <tr>
            <td>
              <span class="text-primary fw-bolder"><%= formatTransactionReference(tx.id, tx.happened_on) %></span>
            </td>
            <td>
              <div class="d-flex flex-column">
                <span class="text-gray-900 fw-bolder fs-6"><%= tx.user_name %></span>
                <span class="text-muted fs-8"><%= tx.user_email %></span>
              </div>
            </td>
            <td>
              <span class="badge badge-light fw-bolder fs-7"><%= tx.category %></span>
            </td>
            <td class="text-gray-600 fw-bold">
              <%= formatDate(tx.happened_on) %>
            </td>
            <td>
              <span class="badge badge-light-<%= isIncome ? 'success' : 'danger' %> fs-7">
                <%= isIncome ? 'Pemasukan' : 'Pengeluaran' %>
              </span>
            </td>
            <td class="text-end">
              <span class="fs-6 fw-bolder <%= isIncome ? 'text-success' : 'text-danger' %>">
                <%= formatRupiah(tx.amount) %>
              </span>
            </td>
          </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
    <% } else { %>
    <div class="text-center py-8 text-muted fs-6">
      Belum ada transaksi di dalam sistem.
    </div>
    <% } %>
  </div>
</div>
<!--end::System Transactions Card-->

<%- include('partials/footer') %>
