<%- include('partials/header') %>

<div class="card card-flush shadow-sm text-center py-12 px-6 max-w-700px mx-auto my-10">
  <div class="mb-6">
    <img src="/static/demo8/dist/assets/media/illustrations/sketchy-1/18.png" alt="Error" class="mw-100 mh-250px" />
  </div>
  <h1 class="fs-2x fw-bolder text-gray-900 mb-3"><%= title %></h1>
  <p class="fs-6 text-gray-600 mb-7 max-w-500px mx-auto">
    <%= message %>
  </p>
  <div>
    <a href="<%= user ? '/dashboard' : '/login' %>" class="btn btn-primary fw-bolder px-8 py-3">
      Kembali ke <%= user ? 'Dashboard' : 'Halaman Masuk' %>
    </a>
  </div>
</div>

<%- include('partials/footer') %>
