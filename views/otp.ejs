<%- include('partials/header') %><div class="auth-card"><div class="eyebrow"><%= mode === 'activation' ? 'VERIFIKASI NOMOR WHATSAPP' : 'PEMULIHAN AKUN' %></div><h1><%= mode === 'activation' ? 'Satu langkah lagi.' : 'Buat kata sandi baru.' %></h1><p class="auth-lead"><%= mode === 'activation' ? `Kami mengirimkan kode 6 digit ke WhatsApp ${whatsapp}. Kode berlaku selama 5 menit.` : 'Masukkan kode 6 digit yang dikirim ke WhatsApp akun Anda, lalu tentukan kata sandi baru.' %></p><form method="post" action="<%= mode === 'activation' ? '/aktivasi' : '/reset-password' %>" class="form-stack"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><label>Kode OTP<input name="code" type="text" inputmode="numeric" autocomplete="one-time-code" pattern="[0-9]{6}" maxlength="6" placeholder="000000" required></label><% if (mode === 'reset') { %><label>Kata sandi baru<input name="password" type="password" minlength="8" autocomplete="new-password" placeholder="Minimal 8 karakter" required></label><% } %><button class="button primary full"><%= mode === 'activation' ? 'Verifikasi dan aktifkan akun' : 'Simpan kata sandi baru' %><span>→</span></button></form><form method="post" action="<%= mode === 'activation' ? '/aktivasi/kirim-ulang' : '/reset-password/kirim-ulang' %>" class="resend-form"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><span>Belum menerima kode?</span><button>Kirim ulang OTP</button></form><div class="auth-switch"><a href="<%= mode === 'activation' ? '/register' : '/login' %>"><%= mode === 'activation' ? 'Kembali ke pendaftaran' : 'Kembali ke halaman masuk' %></a></div></div><%- include('partials/footer') %>
