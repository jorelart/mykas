<%- include('partials/header') %>

<!--begin::OTP Header-->
<div class="text-center mb-6">
  <div class="mb-4">
    <img alt="Verifikasi" class="mh-80px" src="/static/demo8/dist/assets/media/svg/misc/smartphone.svg" />
  </div>
  <h1 class="text-gray-900 mb-2 fs-2x fw-bolder">
    <%= mode === 'activation' ? 'Verifikasi WhatsApp' : 'Atur Sandi Baru' %>
  </h1>
  <div class="text-muted fw-bold fs-7">
    <%= mode === 'activation' 
      ? `Kode verifikasi 6 digit telah dikirim ke WhatsApp ${whatsapp}. Kode berlaku selama 5 menit.` 
      : 'Masukkan kode 6 digit yang dikirim ke nomor WhatsApp Anda, lalu tentukan kata sandi baru.' 
    %>
  </div>
</div>
<!--end::OTP Header-->

<!--begin::OTP Form-->
<form method="post" action="<%= mode === 'activation' ? '/aktivasi' : '/reset-password' %>" class="form w-100">
  <input type="hidden" name="_csrf" value="<%= csrfToken %>" />

  <div class="fv-row mb-6 text-center">
    <label class="form-label fs-7 fw-bolder text-gray-900 d-block mb-3">Masukkan 6 Digit Kode OTP</label>
    <input type="text" name="code" class="form-control form-control-solid fs-2x text-center fw-bolder" inputmode="numeric" pattern="[0-9]{6}" maxlength="6" placeholder="000000" style="letter-spacing: 0.35em;" required autocomplete="one-time-code" />
  </div>

  <% if (mode === 'reset') { %>
  <div class="fv-row mb-6">
    <label class="form-label fs-7 fw-bolder text-gray-900">Kata Sandi Baru</label>
    <input type="password" name="password" class="form-control form-control-solid" minlength="8" maxlength="72" placeholder="Minimal 8 karakter" required autocomplete="new-password" />
  </div>
  <% } %>

  <div class="text-center mb-4">
    <button type="submit" class="btn btn-primary w-100 fw-bolder py-3 shadow-sm">
      <%= mode === 'activation' ? 'Verifikasi & Aktifkan Akun' : 'Simpan Kata Sandi Baru' %>
    </button>
  </div>
</form>
<!--end::OTP Form-->

<!--begin::Resend Form-->
<form method="post" action="<%= mode === 'activation' ? '/aktivasi/kirim-ulang' : '/reset-password/kirim-ulang' %>" class="d-flex align-items-center justify-content-between p-3 bg-light rounded mb-5">
  <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
  <span class="text-gray-600 fs-7">Belum menerima kode?</span>
  <button type="submit" class="btn btn-link link-primary p-0 fw-bolder fs-7 text-decoration-none">Kirim Ulang OTP</button>
</form>
<!--end::Resend Form-->

<div class="text-center">
  <a href="<%= mode === 'activation' ? '/register' : '/login' %>" class="text-muted text-hover-primary fs-7 fw-bold">
    ← <%= mode === 'activation' ? 'Kembali ke pendaftaran' : 'Kembali ke halaman masuk' %>
  </a>
</div>

<%- include('partials/footer') %>
