<%- include('partials/header') %>
<section class="rounded-3xl border border-slate-200 bg-white p-7 shadow-xl shadow-slate-900/5 dark:border-slate-700 dark:bg-slate-900 sm:p-9"><p class="text-xs font-bold uppercase tracking-[.18em] text-indigo-600 dark:text-indigo-300"><%= mode === 'activation' ? 'Verifikasi nomor WhatsApp' : 'Pemulihan akun' %></p><h1 class="mt-3 text-2xl font-bold tracking-tight text-slate-900 dark:text-white"><%= mode === 'activation' ? 'Satu langkah lagi.' : 'Buat kata sandi baru.' %></h1><p class="mt-3 text-sm leading-6 text-slate-600 dark:text-slate-300"><%= mode === 'activation' ? `Kami mengirim kode 6 digit ke WhatsApp ${whatsapp}. Kode berlaku selama 5 menit.` : 'Masukkan kode 6 digit yang dikirim ke WhatsApp akun Anda, lalu tentukan kata sandi baru.' %></p><form method="post" action="<%= mode === 'activation' ? '/aktivasi' : '/reset-password' %>" class="mt-7 space-y-5"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><label class="block text-sm font-semibold text-slate-700 dark:text-slate-200">Kode OTP<input class="mt-2 block w-full rounded-xl border border-slate-300 bg-white px-4 py-3 text-center font-mono text-lg tracking-[.35em] text-slate-900 outline-none focus:border-indigo-500 focus:ring-4 focus:ring-indigo-500/15 dark:border-slate-700 dark:bg-slate-800 dark:text-white" name="code" type="text" inputmode="numeric" autocomplete="one-time-code" pattern="[0-9]{6}" maxlength="6" placeholder="000000" required></label><% if (mode === 'reset') { %><label class="block text-sm font-semibold text-slate-700 dark:text-slate-200">Kata sandi baru<input class="mt-2 block w-full rounded-xl border border-slate-300 bg-white px-4 py-3 text-sm text-slate-900 outline-none focus:border-indigo-500 focus:ring-4 focus:ring-indigo-500/15 dark:border-slate-700 dark:bg-slate-800 dark:text-white" name="password" type="password" minlength="8" maxlength="72" autocomplete="new-password" placeholder="Minimal 8 karakter" required></label><% } %><button class="inline-flex w-full justify-center rounded-xl bg-indigo-600 px-5 py-3 text-sm font-bold text-white shadow-lg shadow-indigo-600/20 hover:bg-indigo-700 focus:outline-none focus:ring-4 focus:ring-indigo-300"><%= mode === 'activation' ? 'Verifikasi dan aktifkan akun' : 'Simpan kata sandi baru' %></button></form><form method="post" action="<%= mode === 'activation' ? '/aktivasi/kirim-ulang' : '/reset-password/kirim-ulang' %>" class="mt-5 flex flex-wrap items-center justify-between gap-3 border-t border-slate-200 pt-5 text-sm dark:border-slate-700"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><span class="text-slate-600 dark:text-slate-300">Belum menerima kode?</span><button class="font-bold text-indigo-700 hover:underline dark:text-indigo-300">Kirim ulang OTP</button></form><a class="mt-5 block text-center text-sm font-semibold text-slate-600 hover:text-indigo-700 dark:text-slate-300 dark:hover:text-indigo-300" href="<%= mode === 'activation' ? '/register' : '/login' %>"><%= mode === 'activation' ? 'Kembali ke pendaftaran' : 'Kembali ke halaman masuk' %></a></section>
<%- include('partials/footer') %>
