<%- include('partials/header') %>
<div class="page-heading"><div><div class="eyebrow">RIWAYAT PENCATATAN</div><h1>Transaksi</h1><p>Kelola dan telusuri catatan keuangan Anda.</p></div><a class="button primary" href="/transaksi/tambah"><span class="plus">＋</span> Tambah transaksi</a></div>
<section class="panel" style="margin-bottom:20px;padding:20px"><div class="section-heading"><div><h2>Dompet</h2><p>Buat dompet, lalu pindahkan transaksi lama yang belum memiliki dompet.</p></div></div><form method="post" action="/transaksi/dompet" class="filter-bar"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><label>Nama dompet<input name="name" maxlength="60" placeholder="Contoh: Harian" required></label><button class="button secondary">Buat dompet</button><span><%= wallets.length %> dompet tersedia</span></form></section>
<form class="filter-bar" method="get"><label>Jenis<select name="jenis"><option value="">Semua jenis</option><option value="income" <%= kind === 'income' ? 'selected' : '' %>>Pemasukan</option><option value="expense" <%= kind === 'expense' ? 'selected' : '' %>>Pengeluaran</option></select></label><label>Dari tanggal<input type="date" name="dari" value="<%= start %>"></label><label>Sampai tanggal<input type="date" name="sampai" value="<%= end %>"></label><button class="button secondary">Terapkan filter</button><a class="clear-link" href="/transaksi">Reset</a></form>
<div class="table-card"><% if (rows.length) { %><div class="table-scroll"><table><thead><tr><th>TRANSAKSI</th><th>ID TRANSAKSI</th><th>KATEGORI</th><th>TANGGAL</th><th>DOMPET</th><th>SUMBER</th><th class="align-right">NOMINAL</th><th></th></tr></thead><tbody><% rows.forEach(tx => { %><tr><td><span class="transaction-title"><i class="kind-icon <%= tx.kind %>"><%= tx.kind === 'income' ? '↓' : '↑' %></i><span><a class="transaction-detail-link" href="/transaksi/<%= tx.id %>"><strong><%= tx.note || tx.category %></strong></a><small><%= tx.kind === 'income' ? 'Pemasukan' : 'Pengeluaran' %></small></span></span></td><td><a class="reference-link" href="/transaksi/<%= tx.id %>"><%= formatTransactionReference(tx.id,tx.happened_on) %></a></td><td><span class="category-chip"><%= tx.category %></span></td><td><%= formatDate(tx.happened_on) %></td><td><% if (tx.wallet_id) { %><span class="source-label"><%= tx.wallet_name %></span><% } else { %><% if (wallets.length) { %><form method="post" action="/transaksi/<%= tx.id %>/dompet" class="inline-form"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><select name="wallet_id" aria-label="Pilih dompet untuk transaksi"><% wallets.forEach(wallet => { %><option value="<%= wallet.id %>"><%= wallet.name %></option><% }) %></select><button class="button secondary">Pindahkan</button></form><% } else { %><span class="source-label">Tanpa dompet</span><% } %><% } %></td><td><span class="source-label"><%= tx.source === 'whatsapp' ? 'WhatsApp' : 'Manual' %></span></td><td class="align-right amount <%= tx.kind %>"><%= tx.kind === 'income' ? '+' : '−' %> <%= formatRupiah(tx.amount) %></td><td class="row-actions"><a class="icon-button edit" href="/transaksi/<%= tx.id %>/edit" aria-label="Edit transaksi">✎</a><form method="post" class="delete-confirm-form" action="/transaksi/<%= tx.id %>/hapus"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="icon-button delete" aria-label="Hapus transaksi">×</button></form></td></tr><% }) %></tbody></table></div><div class="table-footer">Menampilkan maksimal 250 transaksi terbaru · Pilih ID untuk melihat detail</div><% } else { %><div class="empty-state"><span class="empty-icon">⌕</span><strong>Tidak ada transaksi ditemukan</strong><p>Coba ubah filter atau tambahkan transaksi baru.</p><a class="button secondary" href="/transaksi/tambah">Tambah transaksi</a></div><% } %></div><%- include('partials/footer') %>
