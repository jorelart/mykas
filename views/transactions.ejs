<%- include('partials/header') %>

<!--begin::Filter Card-->
<div class="card mb-7 shadow-sm">
  <div class="card-body py-5">
    <form method="get" action="/transaksi" class="row g-4 align-items-end">
      <div class="col-md-3">
        <label class="form-label fs-7 fw-bolder text-gray-700">Jenis Transaksi</label>
        <select name="jenis" class="form-select form-select-solid">
          <option value="">Semua Jenis</option>
          <option value="income" <%= kind === 'income' ? 'selected' : '' %>>Pemasukan</option>
          <option value="expense" <%= kind === 'expense' ? 'selected' : '' %>>Pengeluaran</option>
        </select>
      </div>

      <div class="col-md-3">
        <label class="form-label fs-7 fw-bolder text-gray-700">Dari Tanggal</label>
        <input type="date" name="dari" class="form-control form-control-solid" value="<%= start %>" />
      </div>

      <div class="col-md-3">
        <label class="form-label fs-7 fw-bolder text-gray-700">Sampai Tanggal</label>
        <input type="date" name="sampai" class="form-control form-control-solid" value="<%= end %>" />
      </div>

      <div class="col-md-3 d-flex gap-2">
        <button type="submit" class="btn btn-primary flex-grow-1">
          <span class="svg-icon svg-icon-2 me-1">
            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none">
              <path d="M19.0759 3H4.72777C3.95892 3 3.47768 3.83148 3.86067 4.49814L8.56967 12.6949C8.84824 13.1802 8.99595 13.7328 8.99595 14.2941V19.5C8.99595 20.3284 9.66752 21 10.4959 21H13.504C14.3325 21 15.004 20.3284 15.004 19.5V14.2941C15.004 13.7328 15.1518 13.1802 15.4303 12.6949L20.1393 4.49814C20.5223 3.83148 20.0411 3 19.2722 3H19.0759Z" fill="currentColor"/>
            </svg>
          </span>
          Terapkan
        </button>
        <a href="/transaksi" class="btn btn-light">Reset</a>
      </div>
    </form>
  </div>
</div>
<!--end::Filter Card-->

<!--begin::Transactions Card-->
<div class="card card-flush shadow-sm">
  <div class="card-header align-items-center py-5 gap-2 gap-md-5">
    <div class="card-title">
      <div>
        <h2 class="fs-4 fw-bolder text-gray-900 mb-0">Daftar Transaksi</h2>
        <span class="fs-7 text-muted fw-bold">
          <% if (activeWallet) { %>
            Menampilkan dompet <strong class="text-primary"><%= activeWallet.name %></strong> ·
          <% } %>
          Maksimal 250 catatan terbaru
        </span>
      </div>
    </div>
    <div class="card-toolbar">
      <a href="/transaksi/tambah" class="btn btn-sm btn-primary">
        <span class="svg-icon svg-icon-3 me-1">
          <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none">
            <rect opacity="0.5" x="11" y="18" width="12" height="2" rx="1" transform="rotate(-90 11 18)" fill="currentColor"/>
            <rect x="6" y="11" width="12" height="2" rx="1" fill="currentColor"/>
          </svg>
        </span>
        Tambah Transaksi
      </a>
    </div>
  </div>

  <div class="card-body pt-0">
    <% if (rows.length) { %>
    <div class="table-responsive">
      <table class="table align-middle table-row-dashed fs-6 gy-5" id="kt_transactions_table">
        <thead>
          <tr class="text-start text-gray-400 fw-bolder fs-7 text-uppercase gs-0">
            <th class="min-w-200px">Transaksi</th>
            <th class="min-w-120px">ID Transaksi</th>
            <th class="min-w-120px">Kategori</th>
            <th class="min-w-120px">Tanggal</th>
            <th class="min-w-100px">Sumber</th>
            <th class="text-end min-w-120px">Nominal</th>
            <th class="text-end min-w-100px">Aksi</th>
          </tr>
        </thead>
        <tbody class="fw-bold text-gray-600">
          <% rows.forEach(tx => { 
            const isIncome = tx.kind === 'income';
          %>
          <tr>
            <td>
              <div class="d-flex align-items-center">
                <div class="symbol symbol-40px <%= isIncome ? 'symbol-light-success' : 'symbol-light-danger' %> me-3">
                  <span class="symbol-label">
                    <span class="svg-icon svg-icon-3 <%= isIncome ? 'svg-icon-success' : 'svg-icon-danger' %>">
                      <% if (isIncome) { %>
                      <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none">
                        <rect opacity="0.5" x="11" y="18" width="13" height="2" rx="1" transform="rotate(-90 11 18)" fill="currentColor"/>
                        <path d="M11.4343 15.4343L7.25 11.25C6.83579 10.8358 6.16421 10.8358 5.75 11.25C5.33579 11.6642 5.33579 12.3358 5.75 12.75L11.2929 18.2929C11.6834 18.6834 12.3166 18.6834 12.7071 18.2929L18.25 12.75C18.6642 12.3358 18.6642 11.6642 18.25 11.25L12.5657 15.4343C12.2533 15.7467 11.7467 15.7467 11.4343 15.4343Z" fill="currentColor"/>
                      </svg>
                      <% } else { %>
                      <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none">
                        <rect opacity="0.5" x="13" y="6" width="13" height="2" rx="1" transform="rotate(90 13 6)" fill="currentColor"/>
                        <path d="M12.5657 8.56569L16.75 12.75C17.1642 13.1642 17.8358 13.1642 18.25 12.75C18.6642 12.3358 18.6642 11.6642 18.25 11.25L12.7071 5.70711C12.3166 5.31658 11.6834 5.31658 11.2929 5.70711L5.75 11.25C5.33579 11.6642 5.33579 12.3358 5.75 12.75C6.16421 13.1642 6.83579 13.1642 7.25 12.75L11.4343 8.56569C11.7467 8.25327 12.2533 8.25327 12.5657 8.56569Z" fill="currentColor"/>
                      </svg>
                      <% } %>
                    </span>
                  </span>
                </div>
                <div class="d-flex flex-column">
                  <a href="/transaksi/<%= tx.id %>" class="text-gray-800 text-hover-primary fs-6 fw-bolder text-truncate" style="max-width: 280px;"><%= tx.note || tx.category %></a>
                  <span class="text-muted fw-bold fs-7"><%= isIncome ? 'Pemasukan' : 'Pengeluaran' %></span>
                </div>
              </div>
            </td>
            <td>
              <a href="/transaksi/<%= tx.id %>" class="text-primary fw-bolder"><%= formatTransactionReference(tx.id, tx.happened_on) %></a>
            </td>
            <td>
              <span class="badge badge-light fw-bolder fs-7"><%= tx.category %></span>
            </td>
            <td class="text-gray-600 fw-bold">
              <%= formatDate(tx.happened_on) %>
            </td>
            <td>
              <span class="badge badge-light-<%= tx.source === 'whatsapp' ? 'success' : 'primary' %> fs-7">
                <%= tx.source === 'whatsapp' ? 'WhatsApp' : 'Manual' %>
              </span>
            </td>
            <td class="text-end">
              <span class="fs-6 fw-bolder <%= isIncome ? 'text-success' : 'text-danger' %>">
                <%= isIncome ? '+' : '−' %> <%= formatRupiah(tx.amount) %>
              </span>
            </td>
            <td class="text-end">
              <div class="d-inline-flex gap-1">
                <a href="/transaksi/<%= tx.id %>/edit" class="btn btn-icon btn-bg-light btn-active-color-primary btn-sm" title="Edit Transaksi">
                  <span class="svg-icon svg-icon-3">
                    <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none">
                      <path opacity="0.3" d="M21.4 8.35303L19.241 10.511L13.485 4.755L15.643 2.59595C16.0248 2.21423 16.5426 1.99988 17.0825 1.99988C17.6224 1.99988 18.1402 2.21423 18.522 2.59595L21.4 5.474C21.7817 5.85581 21.9962 6.37355 21.9962 6.91345C21.9962 7.45335 21.7817 7.97122 21.4 8.35303ZM3.68699 21.932L9.88699 19.865L4.13099 14.109L2.06399 20.309C1.98815 20.5354 1.97703 20.7787 2.03189 21.0111C2.08674 21.2436 2.2054 21.4561 2.37449 21.6248C2.54359 21.7934 2.75641 21.9115 2.989 21.9658C3.22158 22.0201 3.4647 22.0084 3.69099 21.932H3.68699Z" fill="currentColor"/>
                      <path d="M5.574 21.3L3.692 21.928C3.46591 22.0032 3.22334 22.0141 2.99144 21.9594C2.75954 21.9046 2.54744 21.7864 2.3789 21.6179C2.21036 21.4495 2.09202 21.2375 2.03711 21.0056C1.9822 20.7737 1.99289 20.5312 2.06799 20.3051L2.696 18.422L5.574 21.3ZM4.13499 14.105L9.891 19.861L19.245 10.507L13.489 4.75098L4.13499 14.105Z" fill="currentColor"/>
                    </svg>
                  </span>
                </a>
                <form method="post" action="/transaksi/<%= tx.id %>/hapus" class="delete-confirm-form m-0 d-inline" data-confirm-message="Transaksi akan dihapus dari riwayat dan laporan.">
                  <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
                  <button type="submit" class="btn btn-icon btn-bg-light btn-active-color-danger btn-sm" title="Hapus Transaksi">
                    <span class="svg-icon svg-icon-3">
                      <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none">
                        <path d="M5 9C5 8.44772 5.44772 8 6 8H18C18.5523 8 19 8.44772 19 9V18C19 19.6569 17.6569 21 16 21H8C6.34315 21 5 19.6569 5 18V9Z" fill="currentColor"/>
                        <path opacity="0.5" d="M5 5C5 4.44772 5.44772 4 6 4H18C18.5523 4 19 4.44772 19 5V5C19 5.55228 18.5523 6 18 6H6C5.44772 6 5 5.55228 5 5V5Z" fill="currentColor"/>
                        <path opacity="0.5" d="M9 4C9 3.44772 9.44772 3 10 3H14C14.5523 3 15 3.44772 15 4V4H9V4Z" fill="currentColor"/>
                      </svg>
                    </span>
                  </button>
                </form>
              </div>
            </td>
          </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
    <% } else { %>
    <div class="text-center py-15">
      <div class="symbol symbol-60px symbol-circle bg-light-primary mb-4 p-3">
        <span class="svg-icon svg-icon-2x svg-icon-primary">
          <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none">
            <rect opacity="0.5" x="17.0365" y="15.1223" width="8.15546" height="2" rx="1" transform="rotate(45 17.0365 15.1223)" fill="currentColor" />
            <path d="M11 19C6.55556 19 3 15.4444 3 11C3 6.55556 6.55556 3 11 3C15.4444 3 19 6.55556 19 11C19 15.4444 15.4444 19 11 19ZM11 5C7.53333 5 5 7.53333 5 11C5 14.4667 7.53333 17 11 17C14.4667 17 17 14.4667 17 11C17 7.53333 14.4667 5 11 5Z" fill="currentColor" />
          </svg>
        </span>
      </div>
      <h3 class="fs-4 fw-bolder text-gray-800 mb-2">Tidak ada transaksi ditemukan</h3>
      <p class="fs-6 text-gray-500 mb-5">Coba ubah filter pencarian atau tambahkan transaksi baru.</p>
      <a href="/transaksi/tambah" class="btn btn-sm btn-primary">Tambah Transaksi Baru</a>
    </div>
    <% } %>
  </div>
</div>
<!--end::Transactions Card-->

<%- include('partials/footer') %>
