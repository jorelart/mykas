<%- include('partials/header') %>
<div class="mx-auto max-w-7xl space-y-7 px-5 py-8 sm:px-8 lg:px-10">
  <section class="flex flex-col gap-5 sm:flex-row sm:items-end sm:justify-between"><div><p class="text-sm font-bold uppercase tracking-[.18em] text-indigo-600 dark:text-indigo-300">Riwayat pencatatan</p><h1 class="mt-2 text-3xl font-bold tracking-tight text-slate-900 dark:text-white sm:text-4xl">Transaksi</h1><p class="mt-2 text-base text-slate-600 dark:text-slate-300">Kelola dan telusuri catatan keuangan Anda.</p><% if (activeWallet) { %><p class="mt-3 inline-flex items-center gap-2 rounded-full bg-indigo-50 px-3 py-1.5 text-sm font-semibold text-indigo-800 dark:bg-indigo-900/40 dark:text-indigo-200"><span class="h-2 w-2 rounded-full bg-indigo-500"></span>Menampilkan dompet <%= activeWallet.name %></p><% } %></div><a class="inline-flex items-center justify-center gap-2 rounded-xl bg-indigo-600 px-5 py-3 text-sm font-bold text-white shadow-lg shadow-indigo-600/20 transition hover:bg-indigo-700 focus:outline-none focus:ring-4 focus:ring-indigo-300 dark:focus:ring-indigo-800" href="/transaksi/tambah"><span class="text-lg">＋</span> Tambah transaksi</a></section>
  <form class="grid gap-4 rounded-2xl border border-slate-200 bg-white p-4 shadow-sm dark:border-slate-700 dark:bg-slate-800 sm:grid-cols-2 lg:grid-cols-[1fr_1fr_1fr_auto_auto] lg:items-end" method="get"><label class="grid gap-1.5 text-sm font-semibold text-slate-700 dark:text-slate-200">Jenis<select class="h-11 rounded-xl border border-slate-300 bg-white px-3 text-sm text-slate-900 outline-none focus:border-indigo-500 focus:ring-4 focus:ring-indigo-500/15 dark:border-slate-600 dark:bg-slate-900 dark:text-white" name="jenis"><option value="">Semua jenis</option><option value="income" <%= kind === 'income' ? 'selected' : '' %>>Pemasukan</option><option value="expense" <%= kind === 'expense' ? 'selected' : '' %>>Pengeluaran</option></select></label><label class="grid gap-1.5 text-sm font-semibold text-slate-700 dark:text-slate-200">Dari tanggal<input class="h-11 rounded-xl border border-slate-300 bg-white px-3 text-sm text-slate-900 outline-none focus:border-indigo-500 focus:ring-4 focus:ring-indigo-500/15 dark:border-slate-600 dark:bg-slate-900 dark:text-white" type="date" name="dari" value="<%= start %>"></label><label class="grid gap-1.5 text-sm font-semibold text-slate-700 dark:text-slate-200">Sampai tanggal<input class="h-11 rounded-xl border border-slate-300 bg-white px-3 text-sm text-slate-900 outline-none focus:border-indigo-500 focus:ring-4 focus:ring-indigo-500/15 dark:border-slate-600 dark:bg-slate-900 dark:text-white" type="date" name="sampai" value="<%= end %>"></label><button class="h-11 rounded-xl bg-slate-900 px-5 text-sm font-bold text-white transition hover:bg-slate-700 dark:bg-indigo-600 dark:hover:bg-indigo-500">Terapkan</button><a class="inline-flex h-11 items-center justify-center px-3 text-sm font-bold text-slate-600 hover:text-slate-900 dark:text-slate-300 dark:hover:text-white" href="/transaksi">Reset</a></form>
  <section class="overflow-hidden rounded-2xl border border-slate-200 bg-white shadow-sm dark:border-slate-700 dark:bg-slate-800">
    <div class="flex flex-wrap items-center justify-between gap-2 border-b border-slate-200 px-5 py-4 dark:border-slate-700 sm:px-7"><h2 class="text-base font-bold text-slate-900 dark:text-white">Daftar transaksi</h2><span class="text-sm font-medium text-slate-600 dark:text-slate-300">Maksimal 250 catatan terbaru</span></div>
    <% if (rows.length) { %><div class="overflow-x-auto"><table class="min-w-full divide-y divide-slate-200 text-left dark:divide-slate-700"><thead class="bg-slate-50 dark:bg-slate-900/60"><tr><th class="px-5 py-3 text-xs font-bold uppercase tracking-wider text-slate-600 dark:text-slate-300 sm:px-7">Transaksi</th><th class="px-5 py-3 text-xs font-bold uppercase tracking-wider text-slate-600 dark:text-slate-300">ID transaksi</th><th class="px-5 py-3 text-xs font-bold uppercase tracking-wider text-slate-600 dark:text-slate-300">Kategori</th><th class="px-5 py-3 text-xs font-bold uppercase tracking-wider text-slate-600 dark:text-slate-300">Tanggal</th><th class="px-5 py-3 text-xs font-bold uppercase tracking-wider text-slate-600 dark:text-slate-300">Sumber</th><th class="px-5 py-3 text-right text-xs font-bold uppercase tracking-wider text-slate-600 dark:text-slate-300">Nominal</th><th class="px-5 py-3 text-right text-xs font-bold uppercase tracking-wider text-slate-600 dark:text-slate-300 sm:pr-7">Aksi</th></tr></thead><tbody class="divide-y divide-slate-100 dark:divide-slate-700"><% rows.forEach(tx => { %><tr class="transition hover:bg-slate-50 dark:hover:bg-slate-700/40"><td class="px-5 py-4 sm:px-7"><div class="flex items-center gap-3"><span class="grid h-10 w-10 shrink-0 place-items-center rounded-xl <%= tx.kind === 'income' ? 'bg-emerald-50 text-emerald-700 dark:bg-emerald-900/40 dark:text-emerald-300' : 'bg-rose-50 text-rose-700 dark:bg-rose-900/40 dark:text-rose-300' %>"><%= tx.kind === 'income' ? '↓' : '↑' %></span><span class="min-w-0"><a class="block max-w-52 truncate text-sm font-bold text-slate-900 hover:text-indigo-700 dark:text-white dark:hover:text-indigo-300" href="/transaksi/<%= tx.id %>"><%= tx.note || tx.category %></a><span class="mt-1 block text-sm font-medium text-slate-600 dark:text-slate-300"><%= tx.kind === 'income' ? 'Pemasukan' : 'Pengeluaran' %></span></span></div></td><td class="whitespace-nowrap px-5 py-4 text-sm font-semibold text-indigo-700 dark:text-indigo-300"><a class="hover:underline" href="/transaksi/<%= tx.id %>"><%= formatTransactionReference(tx.id,tx.happened_on) %></a></td><td class="whitespace-nowrap px-5 py-4 text-sm font-semibold text-slate-700 dark:text-slate-200"><span class="rounded-full bg-slate-100 px-3 py-1.5 dark:bg-slate-700"><%= tx.category %></span></td><td class="whitespace-nowrap px-5 py-4 text-sm font-semibold text-slate-700 dark:text-slate-200"><%= formatDate(tx.happened_on) %></td><td class="whitespace-nowrap px-5 py-4 text-sm font-semibold text-slate-700 dark:text-slate-200"><%= tx.source === 'whatsapp' ? 'WhatsApp' : 'Manual' %></td><td class="whitespace-nowrap px-5 py-4 text-right text-sm font-bold <%= tx.kind === 'income' ? 'text-emerald-700 dark:text-emerald-300' : 'text-rose-700 dark:text-rose-300' %>"><%= tx.kind === 'income' ? '+' : '−' %> <%= formatRupiah(tx.amount) %></td><td class="whitespace-nowrap px-5 py-4 text-right sm:pr-7"><div class="inline-flex items-center gap-1"><a class="grid h-9 w-9 place-items-center rounded-lg text-sm font-bold text-indigo-700 hover:bg-indigo-50 dark:text-indigo-300 dark:hover:bg-slate-700" href="/transaksi/<%= tx.id %>/edit" aria-label="Edit transaksi">✎</a><form method="post" class="delete-confirm-form" action="/transaksi/<%= tx.id %>/hapus"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="grid h-9 w-9 place-items-center rounded-lg text-lg font-bold text-rose-600 hover:bg-rose-50 dark:text-rose-300 dark:hover:bg-rose-900/30" aria-label="Hapus transaksi">×</button></form></div></td></tr><% }) %></tbody></table></div><div class="border-t border-slate-200 px-5 py-3 text-sm font-medium text-slate-600 dark:border-slate-700 dark:text-slate-300">Pilih ID transaksi untuk melihat detail.</div><% } else { %><div class="px-6 py-16 text-center"><span class="mx-auto grid h-14 w-14 place-items-center rounded-2xl bg-indigo-50 text-2xl text-indigo-700 dark:bg-indigo-900/40 dark:text-indigo-300">⌕</span><h3 class="mt-4 text-base font-bold text-slate-900 dark:text-white">Tidak ada transaksi ditemukan</h3><p class="mt-2 text-sm text-slate-600 dark:text-slate-300">Coba ubah filter atau tambahkan transaksi baru.</p><a class="mt-5 inline-flex rounded-xl bg-indigo-600 px-4 py-2.5 text-sm font-bold text-white hover:bg-indigo-700" href="/transaksi/tambah">Tambah transaksi</a></div><% } %>
  </section>
</div>
<%- include('partials/footer') %>
