<% if (user) { %>
    </main>
    <footer class="mykas-footer"><span>© 2026 MyKas</span><span>Keuangan lebih tertata, keputusan lebih bermakna.</span></footer>
  </div>
</div></div>
<% } else { %>
  </main><p class="mykas-auth-foot">© 2026 MyKas · Catatan keuangan Anda, dalam satu tempat.</p>
</div>
<% } %>
<script src="/static/demo8/dist/assets/plugins/global/plugins.bundle.js"></script>
<script src="/static/demo8/dist/assets/js/scripts.bundle.js"></script>
<script src="/vendor/sweetalert2/sweetalert2.min.js"></script>
<script>
document.addEventListener('submit', async (event) => {
  const form = event.target.closest('.delete-confirm-form');
  if (!form || form.dataset.confirmed === 'true') return;
  event.preventDefault();
  const message = form.dataset.confirmMessage || 'Transaksi akan disembunyikan dari riwayat dan laporan. Data tetap tersimpan sebagai soft delete.';
  const result = window.Swal
    ? await Swal.fire({ title: 'Hapus transaksi?', text: message, icon: 'warning', showCancelButton: true, confirmButtonText: 'Ya, hapus', cancelButtonText: 'Batal', confirmButtonColor: '#d76868', reverseButtons: true, focusCancel: true })
    : { isConfirmed: window.confirm(`${message} Lanjutkan?`) };
  if (result.isConfirmed) { form.dataset.confirmed = 'true'; HTMLFormElement.prototype.submit.call(form); }
});
document.addEventListener('submit', async (event) => {
  const form = event.target.closest('.suspend-confirm-form');
  if (!form || form.dataset.confirmed === 'true') return;
  event.preventDefault();
  const warning = `${form.dataset.userName || 'Pengguna ini'} tidak akan bisa masuk atau menggunakan bot WhatsApp sampai akunnya diaktifkan kembali.`;
  const result = window.Swal
    ? await Swal.fire({ title: 'Suspend akun ini?', text: warning, icon: 'warning', showCancelButton: true, confirmButtonText: 'Ya, suspend akun', cancelButtonText: 'Batal', confirmButtonColor: '#d97706', reverseButtons: true, focusCancel: true })
    : { isConfirmed: window.confirm(`${warning} Lanjutkan?`) };
  if (result.isConfirmed) { form.dataset.confirmed = 'true'; HTMLFormElement.prototype.submit.call(form); }
});
document.querySelector('.theme-toggle')?.addEventListener('click', () => {
  const dark = document.documentElement.classList.toggle('dark');
  try { localStorage.setItem('mykas-theme', dark ? 'dark' : 'light'); } catch (_) {}
});
</script>
</body></html>
