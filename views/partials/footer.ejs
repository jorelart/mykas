<script src="/vendor/sweetalert2/sweetalert2.min.js"></script>
<script>
document.addEventListener('submit', async (event) => {
  const form = event.target.closest('.delete-confirm-form');
  if (!form || form.dataset.confirmed === 'true') return;
  event.preventDefault();
  const message = form.dataset.confirmMessage || 'Data transaksi akan dihapus dari riwayat.';
  const result = window.Swal
    ? await Swal.fire({ 
        title: 'Hapus data?', 
        text: message, 
        icon: 'warning', 
        showCancelButton: true, 
        confirmButtonText: 'Ya, hapus', 
        cancelButtonText: 'Batal', 
        customClass: { confirmButton: 'btn btn-danger', cancelButton: 'btn btn-light' }, 
        buttonsStyling: false, 
        reverseButtons: true 
      })
    : { isConfirmed: window.confirm(`${message} Lanjutkan?`) };
  if (result.isConfirmed) { 
    form.dataset.confirmed = 'true'; 
    HTMLFormElement.prototype.submit.call(form); 
  }
});

document.addEventListener('submit', async (event) => {
  const form = event.target.closest('.suspend-confirm-form');
  if (!form || form.dataset.confirmed === 'true') return;
  event.preventDefault();
  const warning = `${form.dataset.userName || 'Pengguna ini'} tidak akan bisa masuk atau menggunakan bot WhatsApp sampai akunnya diaktifkan kembali.`;
  const result = window.Swal
    ? await Swal.fire({ 
        title: 'Tangguhkan akun ini?', 
        text: warning, 
        icon: 'warning', 
        showCancelButton: true, 
        confirmButtonText: 'Ya, tangguhkan akun', 
        cancelButtonText: 'Batal', 
        customClass: { confirmButton: 'btn btn-warning', cancelButton: 'btn btn-light' }, 
        buttonsStyling: false, 
        reverseButtons: true 
      })
    : { isConfirmed: window.confirm(`${warning} Lanjutkan?`) };
  if (result.isConfirmed) { 
    form.dataset.confirmed = 'true'; 
    HTMLFormElement.prototype.submit.call(form); 
  }
});
</script>
