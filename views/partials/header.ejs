<!doctype html><html lang="id"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title><%= title %> · Kasirapi</title><link rel="preconnect" href="https://fonts.googleapis.com"><link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Manrope:wght@500;600;700;800&display=swap" rel="stylesheet"><link rel="stylesheet" href="/static/css/style.css"></head><body>
<% if (user) { %><div class="app-shell"><aside class="sidebar"><a class="brand" href="/dashboard"><span class="brand-mark">K</span><span>kasirapi<span class="brand-dot">.</span><small>FINANCE TRACKER</small></span></a><div class="side-label">MENU UTAMA</div><nav class="side-nav"><a class="nav-link <%= currentPath === '/dashboard' ? 'active' : '' %>" href="/dashboard"><span class="nav-icon">⌂</span>Dashboard</a><a class="nav-link <%= currentPath.startsWith('/transaksi') ? 'active' : '' %>" href="/transaksi"><span class="nav-icon">↔</span>Transaksi</a><a class="nav-link <%= currentPath === '/laporan' ? 'active' : '' %>" href="/laporan"><span class="nav-icon">▤</span>Laporan</a></nav><div class="sidebar-bottom"><div class="help-card"><span class="help-icon">✦</span><strong>Kelola lewat WhatsApp</strong><p>Kirim <b>masuk 50000</b> atau <b>keluar 25000</b>. Ketik <b>saldo</b> untuk ringkasan, <b>dashboard</b> untuk tautan.</p><a href="/laporan#whatsapp">Panduan integrasi <span>↗</span></a></div><div class="profile"><div class="avatar"><%= user.name.slice(0,1).toUpperCase() %></div><div class="profile-copy"><strong><%= user.name %></strong><small><%= user.email %></small></div><form method="post" action="/logout"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="logout" title="Keluar">↗</button></form></div></div></aside><main class="main-area"><header class="topbar"><div class="breadcrumb">Ruang kerja <span>/</span> <%= title %></div><div class="topbar-right"><span class="live-dot"></span><span>Data tersimpan</span></div></header><section class="page-content">
<% } else { %><main class="auth-wrap"><div class="auth-brand"><a class="brand" href="/login"><span class="brand-mark">K</span><span>kasirapi<span class="brand-dot">.</span><small>FINANCE TRACKER</small></span></a></div><div class="auth-content">
<% } %>
<% if (flashMessages && flashMessages.length) { %><div class="flash-stack"><% flashMessages.forEach(item => { %><div class="flash <%= item.type %>"><%= item.message %><button onclick="this.parentElement.remove()">×</button></div><% }) %></div><% } %>
