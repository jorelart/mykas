<!doctype html><html lang="id"><head><script>try{if(localStorage.getItem('mykas-theme')==='dark')document.documentElement.classList.add('dark')}catch(e){}</script><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><meta name="color-scheme" content="light dark"><title><%= title %> · MyKas</title><link rel="preconnect" href="https://fonts.googleapis.com"><link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Manrope:wght@500;600;700;800&display=swap" rel="stylesheet"><link rel="stylesheet" href="/static/css/tailwind.css"><% if (!['/dashboard','/transaksi'].includes(currentPath)) { %><link rel="stylesheet" href="/static/css/style.css"><% } %><link rel="stylesheet" href="/vendor/sweetalert2/sweetalert2.min.css"><script defer src="/vendor/sweetalert2/sweetalert2.all.min.js"></script></head><body class="min-h-screen bg-slate-50 font-sans text-slate-900 antialiased dark:bg-slate-950 dark:text-slate-100">
<% if (user) { %><div class="app-shell flex min-h-screen bg-slate-50 dark:bg-slate-950"><aside class="sidebar hidden w-64 shrink-0 flex-col bg-slate-950 px-5 py-7 text-slate-200 lg:flex"><a class="brand flex items-center gap-3 px-2 text-xl font-extrabold tracking-tight text-white" href="/dashboard"><span class="brand-mark grid h-10 w-10 place-items-center rounded-xl bg-indigo-500 text-lg text-white">M</span><span>mykas<span class="brand-dot text-indigo-300">.</span><small class="block text-[10px] font-semibold tracking-[.2em] text-slate-400">FINANCE TRACKER</small></span></a><p class="side-label mt-12 px-3 text-xs font-bold uppercase tracking-[.18em] text-slate-500">Menu utama</p><nav class="side-nav mt-3 grid gap-2"><a class="nav-link flex h-11 items-center gap-3 rounded-xl px-3 text-sm font-semibold transition <%= currentPath === '/dashboard' ? 'active bg-indigo-500/20 text-white' : 'text-slate-300 hover:bg-white/5 hover:text-white' %>" href="/dashboard"><span class="nav-icon">⌂</span>Dashboard</a><a class="nav-link flex h-11 items-center gap-3 rounded-xl px-3 text-sm font-semibold transition <%= currentPath.startsWith('/transaksi') ? 'active bg-indigo-500/20 text-white' : 'text-slate-300 hover:bg-white/5 hover:text-white' %>" href="/transaksi"><span class="nav-icon">↔</span>Transaksi</a><a class="nav-link flex h-11 items-center gap-3 rounded-xl px-3 text-sm font-semibold transition <%= currentPath.startsWith('/dompet') ? 'active bg-indigo-500/20 text-white' : 'text-slate-300 hover:bg-white/5 hover:text-white' %>" href="/dompet"><span class="nav-icon">◈</span>Dompet</a><a class="nav-link flex h-11 items-center gap-3 rounded-xl px-3 text-sm font-semibold transition <%= currentPath === '/laporan' ? 'active bg-indigo-500/20 text-white' : 'text-slate-300 hover:bg-white/5 hover:text-white' %>" href="/laporan"><span class="nav-icon">▤</span>Laporan</a><% if (user.role === 'admin') { %><a class="nav-link flex h-11 items-center gap-3 rounded-xl px-3 text-sm font-semibold transition <%= currentPath.startsWith('/admin') ? 'active bg-indigo-500/20 text-white' : 'text-slate-300 hover:bg-white/5 hover:text-white' %>" href="/admin"><span class="nav-icon">⚙</span>Admin</a><% } %></nav><div class="sidebar-bottom mt-auto"><div class="help-card rounded-2xl border border-slate-800 bg-slate-900 p-4"><span class="help-icon text-indigo-300">✦</span><strong class="mt-2 block text-sm text-white">Kelola lewat WhatsApp</strong><p class="mt-2 text-xs leading-5 text-slate-400">Kirim <b>/masuk 50000</b> atau <b>/keluar 25000</b>. Ketik <b>/dompet</b> untuk dompet, <b>/saldo</b> untuk ringkasan.</p><a class="mt-3 inline-block text-xs font-bold text-indigo-300" href="/laporan#whatsapp">Panduan integrasi ↗</a></div><div class="profile mt-5 flex items-center gap-3 border-t border-slate-800 pt-5"><div class="avatar grid h-9 w-9 place-items-center rounded-full bg-slate-700 font-bold text-white"><%= user.name.slice(0,1).toUpperCase() %></div><div class="profile-copy min-w-0 flex-1"><strong class="block truncate text-sm text-white"><%= user.name %></strong><small class="block truncate text-xs text-slate-400"><%= user.email %></small></div><form method="post" action="/logout"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="logout rounded-lg px-2 py-1 text-slate-300 hover:bg-white/10" title="Keluar">↗</button></form></div></div></aside><main class="main-area flex min-w-0 flex-1 flex-col"><header class="topbar sticky top-0 z-20 flex min-h-16 flex-wrap items-center justify-between gap-3 border-b border-slate-200 bg-white/90 px-5 py-3 backdrop-blur dark:border-slate-800 dark:bg-slate-900/90 sm:px-8"><div class="flex min-w-0 items-center gap-4"><div class="breadcrumb hidden text-sm font-semibold text-slate-600 dark:text-slate-300 sm:block">MyKas <span class="mx-2 text-slate-400">/</span> <%= title %></div><nav class="flex gap-1 lg:hidden"><a class="rounded-lg px-2 py-2 text-xs font-bold text-slate-700 hover:bg-slate-100 dark:text-slate-200 dark:hover:bg-slate-800" href="/dashboard">Home</a><a class="rounded-lg px-2 py-2 text-xs font-bold text-slate-700 hover:bg-slate-100 dark:text-slate-200 dark:hover:bg-slate-800" href="/transaksi">Transaksi</a><a class="rounded-lg px-2 py-2 text-xs font-bold text-slate-700 hover:bg-slate-100 dark:text-slate-200 dark:hover:bg-slate-800" href="/dompet">Dompet</a></nav></div><div class="topbar-right flex flex-wrap items-center gap-3 text-sm font-semibold text-slate-600 dark:text-slate-300"><% if (typeof wallets !== 'undefined' && wallets.length) { %><form class="wallet-switcher flex items-center gap-2" method="post" action="/dompet/select"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="return_to" value="<%= currentPath %>"><label class="hidden text-sm font-bold text-slate-700 dark:text-slate-200 sm:inline" for="active-wallet">Dompet aktif</label><select class="max-w-40 rounded-xl border border-slate-300 bg-white px-3 py-2 text-sm font-bold text-slate-800 outline-none focus:border-indigo-500 focus:ring-4 focus:ring-indigo-500/15 dark:border-slate-700 dark:bg-slate-800 dark:text-white" id="active-wallet" name="wallet_id" onchange="this.form.submit()"><% wallets.forEach(wallet => { %><option value="<%= wallet.id %>" <%= activeWallet && activeWallet.id === wallet.id ? 'selected' : '' %>><%= wallet.name %></option><% }) %></select></form><% } %><button class="theme-toggle grid h-10 w-10 place-items-center rounded-xl border border-slate-200 bg-white text-lg text-slate-700 transition hover:bg-slate-100 dark:border-slate-700 dark:bg-slate-800 dark:text-amber-200 dark:hover:bg-slate-700" type="button" aria-label="Ganti tema" title="Ganti tema">◐</button><span class="live-dot h-2 w-2 rounded-full bg-emerald-500"></span><span class="hidden sm:inline">Data tersimpan</span></div></header><section class="page-content flex-1">
<% } else { %><main class="auth-wrap"><div class="auth-brand"><a class="brand" href="/login"><span class="brand-mark">M</span><span>mykas<span class="brand-dot">.</span><small>FINANCE TRACKER</small></span></a></div><div class="auth-content">
<% } %>
<% if (flashMessages && flashMessages.length) { %><div class="flash-stack mb-5 grid gap-2"><% flashMessages.forEach(item => { %><div class="flex items-start justify-between gap-4 rounded-xl border px-4 py-3 text-sm font-semibold <%= item.type === 'success' ? 'border-emerald-200 bg-emerald-50 text-emerald-800 dark:border-emerald-900 dark:bg-emerald-950/50 dark:text-emerald-200' : item.type === 'danger' ? 'border-rose-200 bg-rose-50 text-rose-800 dark:border-rose-900 dark:bg-rose-950/50 dark:text-rose-200' : item.type === 'warning' ? 'border-amber-200 bg-amber-50 text-amber-800 dark:border-amber-900 dark:bg-amber-950/50 dark:text-amber-200' : 'border-indigo-200 bg-indigo-50 text-indigo-800 dark:border-indigo-900 dark:bg-indigo-950/50 dark:text-indigo-200' %>"><span><%= item.message %></span><button class="font-bold" onclick="this.parentElement.remove()" aria-label="Tutup">×</button></div><% }) %></div><% } %>
