<!doctype html><html lang="id"><head><script>try{if(localStorage.getItem("mykas-theme")==="dark")document.documentElement.classList.add("dark-mode")}catch(e){}</script><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title><%= title %> · MyKas</title><link rel="preconnect" href="https://fonts.googleapis.com"><link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Manrope:wght@500;600;700;800&display=swap" rel="stylesheet"><link rel="stylesheet" href="/static/css/style.css"><link rel="stylesheet" href="/vendor/sweetalert2/sweetalert2.min.css"><script defer src="/vendor/sweetalert2/sweetalert2.all.min.js"></script></head><body>
<% if (user) { %><div class="app-shell"><aside class="sidebar"><a class="brand" href="/dashboard"><span class="brand-mark">M</span><span>mykas<span class="brand-dot">.</span><small>FINANCE TRACKER</small></span></a><div class="side-label">MENU UTAMA</div><nav class="side-nav"><a class="nav-link <%= currentPath === '/dashboard' ? 'active' : '' %>" href="/dashboard"><span class="nav-icon">⌂</span>Dashboard</a><a class="nav-link <%= currentPath.startsWith('/transaksi') ? 'active' : '' %>" href="/transaksi"><span class="nav-icon">↔</span>Transaksi</a><a class="nav-link <%= currentPath.startsWith('/dompet') ? 'active' : '' %>" href="/dompet"><span class="nav-icon">◈</span>Dompet</a><a class="nav-link <%= currentPath === '/laporan' ? 'active' : '' %>" href="/laporan"><span class="nav-icon">▤</span>Laporan</a><% if (user.role === 'admin') { %><a class="nav-link <%= currentPath.startsWith('/admin') ? 'active' : '' %>" href="/admin"><span class="nav-icon">⚙</span>Admin</a><% } %></nav><div class="sidebar-bottom"><div class="help-card"><span class="help-icon">✦</span><strong>Kelola lewat WhatsApp</strong><p>Kirim <b>/masuk 50000</b> atau <b>/keluar 25000</b>. Ketik <b>/dompet</b> untuk dompet, <b>/saldo</b> untuk ringkasan.</p><a href="/laporan#whatsapp">Panduan integrasi <span>↗</span></a></div><div class="profile"><div class="avatar"><%= user.name.slice(0,1).toUpperCase() %></div><div class="profile-copy"><strong><%= user.name %></strong><small><%= user.email %></small></div><form method="post" action="/logout"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="logout" title="Keluar">↗</button></form></div></div></aside><main class="main-area"><header class="topbar"><div class="breadcrumb">Ruang kerja <span>/</span> <%= title %></div><div class="topbar-right"><% if (typeof wallets !== 'undefined' && wallets.length) { %><form class="wallet-switcher" method="post" action="/dompet/select"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="return_to" value="<%= currentPath %>"><label for="active-wallet">Dompet aktif</label><select id="active-wallet" name="wallet_id" onchange="this.form.submit()"><% wallets.forEach(wallet => { %><option value="<%= wallet.id %>" <%= activeWallet && activeWallet.id === wallet.id ? 'selected' : '' %>><%= wallet.name %></option><% }) %></select></form><% } %><button class="theme-toggle" type="button" aria-label="Ganti tema" title="Ganti tema">◐</button><span class="live-dot"></span><span>Data tersimpan</span></div></header><section class="page-content">
<% } else { %><main class="auth-wrap"><div class="auth-brand"><a class="brand" href="/login"><span class="brand-mark">M</span><span>mykas<span class="brand-dot">.</span><small>FINANCE TRACKER</small></span></a></div><div class="auth-content">
<% } %>
<% if (flashMessages && flashMessages.length) { %><div class="flash-stack"><% flashMessages.forEach(item => { %><div class="flash <%= item.type %>"><%= item.message %><button onclick="this.parentElement.remove()">×</button></div><% }) %></div><% } %>
