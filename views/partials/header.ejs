<!doctype html>
<html lang="id" class="<%= (typeof themeDark !== 'undefined' && themeDark) ? 'dark' : '' %>">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="csrf-token" content="<%= csrfToken %>">
  <title><%= title ? `${title} · MyKas` : 'MyKas' %></title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link rel="stylesheet" href="https://fonts.googleapis.com/css?family=Poppins:300,400,500,600,700">
  <link rel="stylesheet" href="/static/css/tailwind.css">
  <link rel="stylesheet" href="/static/demo8/dist/assets/plugins/global/plugins.bundle.css">
  <link rel="stylesheet" href="/static/demo8/dist/assets/css/style.bundle.css">
  <link rel="stylesheet" href="/static/css/mykas-metronic.css">
  <link rel="stylesheet" href="/vendor/sweetalert2/sweetalert2.min.css">
  <script>
    try { if (localStorage.getItem('mykas-theme') === 'dark') document.documentElement.classList.add('dark'); } catch (_) {}
  </script>
</head>
<body id="kt_body" class="mykas-body header-tablet-and-mobile-fixed aside-enabled">
<% if (user) { const navItems = [
  { href: '/dashboard', label: 'Dashboard', icon: '⌂' },
  { href: '/transaksi', label: 'Transaksi', icon: '↕' },
  { href: '/dompet', label: 'Dompet', icon: '▣' },
  { href: '/laporan', label: 'Laporan', icon: '▤' },
  { href: '/profil', label: 'Profil', icon: '◉' },
  ...(user.role === 'admin' ? [{ href: '/admin', label: 'Admin', icon: '⚙' }] : []),
]; const pageTitle = title || (navItems.find(item => currentPath === item.href)?.label || 'MyKas'); %>
<div class="d-flex flex-column flex-root mykas-root"><div class="page d-flex flex-row flex-column-fluid mykas-page">
  <aside id="kt_aside" class="aside mykas-aside" data-kt-drawer="true" data-kt-drawer-name="aside" data-kt-drawer-activate="{default: true, lg: false}" data-kt-drawer-overlay="true" data-kt-drawer-width="260px" data-kt-drawer-direction="start" data-kt-drawer-toggle="#kt_aside_mobile_toggle">
    <a class="mykas-brand" href="/dashboard"><span class="mykas-brand-mark">M</span><span>MyKas</span></a>
    <div class="mykas-aside-label">MENU</div>
    <nav class="menu menu-column mykas-nav" aria-label="Navigasi utama">
      <% navItems.forEach(item => { const active = currentPath === item.href || (item.href !== '/dashboard' && currentPath.startsWith(`${item.href}/`)); %>
      <div class="menu-item"><a class="menu-link <%= active ? 'active' : '' %>" href="<%= item.href %>"><span class="mykas-nav-icon"><%= item.icon %></span><span class="menu-title"><%= item.label %></span></a></div>
      <% }) %>
    </nav>
    <div class="mykas-sidebar-bottom">
      <a class="mykas-user-card" href="/profil"><span class="mykas-avatar"><%= String(user.name || 'U').trim().charAt(0).toUpperCase() %></span><span class="mykas-user-copy"><strong><%= user.name %></strong><small><%= user.email %></small></span></a>
      <form method="post" action="/logout"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="mykas-logout" type="submit">Keluar</button></form>
    </div>
  </aside>
  <div class="wrapper d-flex flex-column flex-row-fluid mykas-wrapper" id="kt_wrapper">
    <header class="mykas-topbar">
      <div class="d-flex align-items-center gap-3"><button class="btn btn-icon btn-light d-lg-none" id="kt_aside_mobile_toggle" aria-label="Buka menu">☰</button><div><p class="mykas-eyebrow">KEUANGAN PRIBADI</p><h1 class="mykas-page-title"><%= pageTitle %></h1></div></div>
      <div class="mykas-topbar-actions">
        <% if (typeof wallets !== 'undefined' && wallets.length) { %>
        <form class="mykas-wallet-picker" method="post" action="/dompet/select"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="return_to" value="<%= ['/dashboard','/transaksi','/laporan','/dompet'].includes(currentPath) ? currentPath : '/dompet' %>"><label for="active-wallet">Dompet aktif</label><select id="active-wallet" name="wallet_id" onchange="this.form.submit()"><% wallets.forEach(wallet => { %><option value="<%= wallet.id %>" <%= activeWallet && Number(activeWallet.id) === Number(wallet.id) ? 'selected' : '' %>><%= wallet.name %> · <%= formatRupiah(wallet.balance) %></option><% }) %></select></form>
        <% } else if (typeof activeWallet !== 'undefined' && activeWallet) { %><a class="mykas-wallet-pill" href="/dompet">Dompet: <strong><%= activeWallet.name %></strong></a><% } %>
        <button class="mykas-theme-toggle theme-toggle" type="button" aria-label="Ganti tema" title="Ganti tema"><span class="theme-toggle-icon">☾</span></button>
      </div>
    </header>
    <main class="mykas-content">
      <% if (flashMessages && flashMessages.length) { %><div class="mykas-flashes"><% flashMessages.forEach(item => { const tone = item.type === 'success' ? 'success' : ['danger','error'].includes(item.type) ? 'danger' : item.type === 'warning' ? 'warning' : 'primary'; %><div class="alert alert-<%= tone %> d-flex align-items-center py-4" role="status"><div class="fw-semibold"><%= item.message %></div></div><% }) %></div><% } %>
<% } else { %>
<div class="mykas-auth-page"><a href="/login" class="mykas-auth-brand"><span class="mykas-brand-mark">M</span> MyKas</a><main class="mykas-auth-content">
  <% if (flashMessages && flashMessages.length) { %><div class="mykas-flashes"><% flashMessages.forEach(item => { %><div class="alert alert-<%= item.type === 'success' ? 'success' : item.type === 'danger' ? 'danger' : 'warning' %>" role="status"><%= item.message %></div><% }) %></div><% } %>
<% } %>
