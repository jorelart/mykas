<%- include('partials/header') %>
<div class="mx-auto max-w-5xl space-y-7 px-5 py-8 sm:px-8 lg:px-10"><section><p class="text-sm font-bold uppercase tracking-[.18em] text-indigo-600 dark:text-indigo-300">Pengaturan akun</p><h1 class="mt-2 text-3xl font-bold tracking-tight text-slate-900 dark:text-white sm:text-4xl">Profil & keamanan</h1><p class="mt-2 text-base text-slate-600 dark:text-slate-300">Perbarui informasi akun dan lindungi akses MyKas Anda.</p></section><div class="grid gap-6 lg:grid-cols-2"><section class="rounded-2xl border border-slate-200 bg-white p-5 shadow-sm dark:border-slate-700 dark:bg-slate-800 sm:p-7"><div class="mb-6"><h2 class="text-lg font-bold text-slate-900 dark:text-white">Informasi profil</h2><p class="mt-1 text-sm text-slate-600 dark:text-slate-300">Nomor WhatsApp digunakan untuk layanan bot dan verifikasi.</p></div><form method="post" action="/profil" class="space-y-5"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><label class="block text-sm font-semibold text-slate-700 dark:text-slate-200">Nama lengkap<input class="mt-2 block w-full rounded-xl border border-slate-300 bg-white px-4 py-3 text-sm text-slate-900 outline-none focus:border-indigo-500 focus:ring-4 focus:ring-indigo-500/15 dark:border-slate-600 dark:bg-slate-900 dark:text-white" name="name" value="<%= account.name %>" maxlength="100" autocomplete="name" required></label><label class="block text-sm font-semibold text-slate-700 dark:text-slate-200">Email<input class="mt-2 block w-full rounded-xl border border-slate-300 bg-white px-4 py-3 text-sm text-slate-900 outline-none focus:border-indigo-500 focus:ring-4 focus:ring-indigo-500/15 dark:border-slate-600 dark:bg-slate-900 dark:text-white" name="email" type="email" value="<%= account.email %>" maxlength="160" autocomplete="email" <%= String(process.env.ADMIN_EMAIL || '').trim().toLowerCase() === account.email.toLowerCase() ? 'readonly' : '' %> required><% if (String(process.env.ADMIN_EMAIL || '').trim().toLowerCase() === account.email.toLowerCase()) { %><span class="mt-2 block text-xs font-medium text-slate-500 dark:text-slate-400">Email admin utama dikelola melalui konfigurasi server.</span><% } %></label><label class="block text-sm font-semibold text-slate-700 dark:text-slate-200">Kata sandi saat ini <span class="font-normal text-slate-500">(diperlukan jika email diubah)</span><input class="mt-2 block w-full rounded-xl border border-slate-300 bg-white px-4 py-3 text-sm text-slate-900 outline-none focus:border-indigo-500 focus:ring-4 focus:ring-indigo-500/15 dark:border-slate-600 dark:bg-slate-900 dark:text-white" name="current_password" type="password" autocomplete="current-password"></label><label class="block text-sm font-semibold text-slate-700 dark:text-slate-200">Nomor WhatsApp<input class="mt-2 block w-full rounded-xl border border-slate-200 bg-slate-50 px-4 py-3 text-sm text-slate-600 dark:border-slate-700 dark:bg-slate-900 dark:text-slate-400" value="<%= account.whatsapp_number %>" readonly><span class="mt-2 block text-xs font-medium text-slate-500 dark:text-slate-400">Hubungi admin untuk mengubah nomor setelah verifikasi.</span></label><button class="rounded-xl bg-indigo-600 px-5 py-3 text-sm font-bold text-white hover:bg-indigo-700">Simpan profil</button></form></section>
<section class="rounded-2xl border border-slate-200 bg-white p-5 shadow-sm dark:border-slate-700 dark:bg-slate-800 sm:p-7"><div class="mb-6"><h2 class="text-lg font-bold text-slate-900 dark:text-white">Ganti kata sandi</h2><p class="mt-1 text-sm text-slate-600 dark:text-slate-300">Masukkan kata sandi saat ini untuk mengonfirmasi perubahan.</p></div><form method="post" action="/profil/password" class="space-y-5"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><label class="block text-sm font-semibold text-slate-700 dark:text-slate-200">Kata sandi saat ini<input class="mt-2 block w-full rounded-xl border border-slate-300 bg-white px-4 py-3 text-sm text-slate-900 outline-none focus:border-indigo-500 focus:ring-4 focus:ring-indigo-500/15 dark:border-slate-600 dark:bg-slate-900 dark:text-white" name="current_password" type="password" autocomplete="current-password" required></label><label class="block text-sm font-semibold text-slate-700 dark:text-slate-200">Kata sandi baru<input class="mt-2 block w-full rounded-xl border border-slate-300 bg-white px-4 py-3 text-sm text-slate-900 outline-none focus:border-indigo-500 focus:ring-4 focus:ring-indigo-500/15 dark:border-slate-600 dark:bg-slate-900 dark:text-white" name="password" type="password" minlength="8" maxlength="72" autocomplete="new-password" required></label><label class="block text-sm font-semibold text-slate-700 dark:text-slate-200">Ulangi kata sandi baru<input class="mt-2 block w-full rounded-xl border border-slate-300 bg-white px-4 py-3 text-sm text-slate-900 outline-none focus:border-indigo-500 focus:ring-4 focus:ring-indigo-500/15 dark:border-slate-600 dark:bg-slate-900 dark:text-white" name="password_confirmation" type="password" minlength="8" maxlength="72" autocomplete="new-password" required></label><button class="rounded-xl border border-slate-300 px-5 py-3 text-sm font-bold text-slate-700 hover:bg-slate-50 dark:border-slate-600 dark:text-slate-100 dark:hover:bg-slate-700">Perbarui kata sandi</button></form></section></div></div>
<%- include('partials/footer') %>
