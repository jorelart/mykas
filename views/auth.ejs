<%- include('partials/header') %><div class="auth-card"><div class="eyebrow">MULAI KELOLA KEUANGAN</div><h1><%= mode === 'register' ? 'Ruang keuangan yang lebih rapi.' : mode === 'forgot' ? 'Atur ulang kata sandi.' : 'Senang melihat Anda kembali.' %></h1><p class="auth-lead"><%= mode === 'register' ? 'Buat akun untuk mencatat pemasukan dan pengeluaran dengan mudah.' : mode === 'forgot' ? 'Masukkan email akun. Kode verifikasi akan dikirim ke WhatsApp yang terhubung.' : 'Masuk untuk melihat ringkasan dan aktivitas keuangan Anda.' %></p><form method="post" action="<%= mode === 'forgot' ? '/lupa-password' : mode === 'register' ? '/register' : '/login' %>" class="form-stack"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><% if (mode === 'register') { %><label>Nama lengkap<input name="name" placeholder="Contoh: Andi Pratama" required maxlength="100" autocomplete="name"></label><% } %><label>Email<input name="email" type="email" placeholder="nama@email.com" required autocomplete="email"></label><% if (mode === 'register') { %><label>Nomor WhatsApp<input name="whatsapp_number" type="tel" placeholder="081234567890" required autocomplete="tel"><small class="field-hint">OTP aktivasi dan reset kata sandi akan dikirim ke nomor ini.</small></label><% } %><% if (mode !== 'forgot') { %><label>Kata sandi<input name="password" type="password" placeholder="<%= mode === 'register' ? 'Minimal 8 karakter' : 'Masukkan kata sandi' %>" required <% if (mode === 'register') { %>minlength="8"<% } %> autocomplete="<%= mode === 'register' ? 'new-password' : 'current-password' %>"></label><% } %><button class="button primary full"><%= mode === 'register' ? 'Lanjutkan aktivasi' : mode === 'forgot' ? 'Kirim kode reset' : 'Masuk ke akun' %><span>→</span></button></form><div class="auth-switch"><% if (mode === 'register') { %>Sudah punya akun? <a href="/login">Masuk</a><% } else if (mode === 'forgot') { %>Ingat kata sandi? <a href="/login">Kembali masuk</a><% } else { %>Belum punya akun? <a href="/register">Daftar gratis</a><br><a class="forgot-link" href="/lupa-password">Lupa kata sandi?</a><% } %></div></div><%- include('partials/footer') %>
