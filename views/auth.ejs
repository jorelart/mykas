<%- include('partials/header') %><div class="auth-card"><div class="eyebrow">MULAI KELOLA KEUANGAN</div><h1><%= mode === 'register' ? 'Ruang keuangan yang lebih rapi.' : 'Senang melihat Anda kembali.' %></h1><p class="auth-lead"><%= mode === 'register' ? 'Buat akun untuk mencatat pemasukan dan pengeluaran dengan mudah.' : 'Masuk untuk melihat ringkasan dan aktivitas keuangan Anda.' %></p><form method="post" class="form-stack"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><% if (mode === 'register') { %><label>Nama lengkap<input name="name" placeholder="Contoh: Andi Pratama" required maxlength="100" autocomplete="name"></label><% } %><label>Email<input name="email" type="email" placeholder="nama@email.com" required autocomplete="email"></label><% if (mode === 'register') { %><label>Nomor WhatsApp <span class="optional">untuk pencatatan otomatis</span><input name="whatsapp_number" type="tel" placeholder="081234567890" required autocomplete="tel"><small class="field-hint">Gunakan nomor yang terhubung ke WhatsApp Anda.</small></label><% } %><label>Kata sandi<input name="password" type="password" placeholder="<%= mode === 'register' ? 'Minimal 8 karakter' : 'Masukkan kata sandi' %>" required <%= mode === 'register' ? 'minlength="8"' : '' %> autocomplete="<%= mode === 'register' ? 'new-password' : 'current-password' %>"></label><button class="button primary full"><%= mode === 'register' ? 'Buat akun gratis' : 'Masuk ke akun' %><span>→</span></button></form><div class="auth-switch"><%= mode === 'register' ? 'Sudah punya akun?' : 'Belum punya akun?' %> <a href="/<%= mode === 'register' ? 'login' : 'register' %>"><%= mode === 'register' ? 'Masuk' : 'Daftar gratis' %></a></div></div><%- include('partials/footer') %>
