<%- include('partials/header') %>
<section class="rounded-3xl border border-slate-200 bg-white p-7 shadow-xl shadow-slate-900/5 dark:border-slate-700 dark:bg-slate-900 sm:p-9"><p class="text-xs font-bold uppercase tracking-[.18em] text-indigo-600 dark:text-indigo-300">MyKas · Keuangan lebih tertata</p><h1 class="mt-3 text-2xl font-bold tracking-tight text-slate-900 dark:text-white"><%= mode === 'register' ? 'Ruang keuangan yang lebih rapi.' : mode === 'forgot' ? 'Atur ulang kata sandi.' : 'Senang melihat Anda kembali.' %></h1><p class="mt-3 text-sm leading-6 text-slate-600 dark:text-slate-300"><%= mode === 'register' ? 'Buat akun untuk mencatat pemasukan dan pengeluaran dengan mudah.' : mode === 'forgot' ? 'Masukkan email akun. Kode verifikasi akan dikirim ke WhatsApp yang terhubung.' : 'Masuk untuk melihat ringkasan dan aktivitas keuangan Anda.' %></p>
<form method="post" action="<%= mode === 'forgot' ? '/lupa-password' : mode === 'register' ? '/register' : '/login' %>" class="mt-7 space-y-5"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><% if (mode === 'register') { %><label class="block text-sm font-semibold text-slate-700 dark:text-slate-200">Nama lengkap<input class="mt-2 block w-full rounded-xl border border-slate-300 bg-white px-4 py-3 text-sm text-slate-900 outline-none placeholder:text-slate-400 focus:border-indigo-500 focus:ring-4 focus:ring-indigo-500/15 dark:border-slate-700 dark:bg-slate-800 dark:text-white" name="name" placeholder="Contoh: Andi Pratama" required maxlength="100" autocomplete="name"></label><% } %><label class="block text-sm font-semibold text-slate-700 dark:text-slate-200">Email<input class="mt-2 block w-full rounded-xl border border-slate-300 bg-white px-4 py-3 text-sm text-slate-900 outline-none placeholder:text-slate-400 focus:border-indigo-500 focus:ring-4 focus:ring-indigo-500/15 dark:border-slate-700 dark:bg-slate-800 dark:text-white" name="email" type="email" placeholder="nama@email.com" required autocomplete="email"></label><% if (mode === 'register') { %><label class="block text-sm font-semibold text-slate-700 dark:text-slate-200">Nomor WhatsApp<input class="mt-2 block w-full rounded-xl border border-slate-300 bg-white px-4 py-3 text-sm text-slate-900 outline-none placeholder:text-slate-400 focus:border-indigo-500 focus:ring-4 focus:ring-indigo-500/15 dark:border-slate-700 dark:bg-slate-800 dark:text-white" name="whatsapp_number" type="tel" placeholder="081234567890" required autocomplete="tel"><small class="mt-2 block text-sm text-slate-500 dark:text-slate-400">OTP aktivasi dan reset kata sandi dikirim ke nomor ini.</small></label><% } %><% if (mode !== 'forgot') { %><label class="block text-sm font-semibold text-slate-700 dark:text-slate-200">Kata sandi<input class="mt-2 block w-full rounded-xl border border-slate-300 bg-white px-4 py-3 text-sm text-slate-900 outline-none placeholder:text-slate-400 focus:border-indigo-500 focus:ring-4 focus:ring-indigo-500/15 dark:border-slate-700 dark:bg-slate-800 dark:text-white" name="password" type="password" placeholder="<%= mode === 'register' ? 'Minimal 8 karakter' : 'Masukkan kata sandi' %>" required <% if (mode === 'register') { %>minlength="8"<% } %> autocomplete="<%= mode === 'register' ? 'new-password' : 'current-password' %>"></label><% } %><button class="inline-flex w-full items-center justify-center gap-2 rounded-xl bg-indigo-600 px-5 py-3 text-sm font-bold text-white shadow-lg shadow-indigo-600/20 transition hover:bg-indigo-700 focus:outline-none focus:ring-4 focus:ring-indigo-300 dark:focus:ring-indigo-800"><%= mode === 'register' ? 'Lanjutkan aktivasi' : mode === 'forgot' ? 'Kirim kode reset' : 'Masuk ke akun' %><span>→</span></button></form>
<div class="mt-6 border-t border-slate-200 pt-5 text-center text-sm text-slate-600 dark:border-slate-700 dark:text-slate-300"><% if (mode === 'register') { %>Sudah punya akun? <a class="font-bold text-indigo-700 hover:underline dark:text-indigo-300" href="/login">Masuk</a><% } else if (mode === 'forgot') { %>Ingat kata sandi? <a class="font-bold text-indigo-700 hover:underline dark:text-indigo-300" href="/login">Kembali masuk</a><% } else { %>Belum punya akun? <a class="font-bold text-indigo-700 hover:underline dark:text-indigo-300" href="/register">Daftar gratis</a><br><a class="mt-3 inline-block font-semibold text-slate-500 hover:text-indigo-700 dark:text-slate-400 dark:hover:text-indigo-300" href="/lupa-password">Lupa kata sandi?</a><% } %></div></section>
<%- include('partials/footer') %>
