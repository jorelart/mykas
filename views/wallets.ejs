<%- include('partials/header') %>
<div class="mx-auto max-w-7xl space-y-7 px-5 py-8 sm:px-8 lg:px-10"><section><p class="text-sm font-bold uppercase tracking-[.18em] text-indigo-600 dark:text-indigo-300">Manajemen keuangan</p><h1 class="mt-2 text-3xl font-bold tracking-tight text-slate-900 dark:text-white sm:text-4xl">Dompet</h1><p class="mt-2 text-base text-slate-600 dark:text-slate-300">Atur pos keuangan dan pilih konteks untuk pencatatan serta laporan.</p></section>
<section class="grid items-start gap-6 md:grid-cols-[minmax(16rem,1fr)_2fr]"><div class="rounded-2xl border border-slate-200 bg-white p-5 shadow-sm dark:border-slate-700 dark:bg-slate-800 sm:p-6"><h2 class="text-lg font-bold text-slate-900 dark:text-white">Buat dompet</h2><p class="mt-1 text-sm text-slate-600 dark:text-slate-300">Contoh: Harian, Rumah, atau Usaha.</p><form method="post" action="/dompet" class="mt-5 grid gap-4 xl:grid-cols-[minmax(0,1fr)_auto] xl:items-end"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><label class="block min-w-0 text-sm font-semibold text-slate-700 dark:text-slate-200">Nama dompet<input class="mt-2 block h-12 w-full rounded-xl border border-slate-300 bg-white px-4 text-sm text-slate-900 outline-none focus:border-indigo-500 focus:ring-4 focus:ring-indigo-500/15 dark:border-slate-600 dark:bg-slate-900 dark:text-white" name="name" maxlength="60" placeholder="Nama dompet" required></label><button class="h-12 whitespace-nowrap rounded-xl bg-indigo-600 px-5 text-sm font-bold text-white hover:bg-indigo-700">Buat dompet</button></form></div>
<div class="overflow-hidden rounded-2xl border border-slate-200 bg-white shadow-sm dark:border-slate-700 dark:bg-slate-800"><div class="border-b border-slate-200 px-5 py-4 dark:border-slate-700"><h2 class="font-bold text-slate-900 dark:text-white">Dompet Anda</h2><p class="mt-1 text-sm text-slate-600 dark:text-slate-300">Pilih dompet aktif atau hapus dompet yang tidak memiliki saldo maupun riwayat.</p></div><% if (wallets.length) { %><div class="divide-y divide-slate-100 dark:divide-slate-700"><% wallets.forEach(wallet => { %><article class="flex flex-col gap-4 px-5 py-4 sm:flex-row sm:items-center sm:justify-between"><div><div class="flex flex-wrap items-center gap-2"><h3 class="font-bold text-slate-900 dark:text-white"><%= wallet.name %></h3><% if (activeWallet && activeWallet.id === wallet.id) { %><span class="rounded-full bg-emerald-100 px-2.5 py-1 text-xs font-bold text-emerald-800 dark:bg-emerald-900/50 dark:text-emerald-200">Aktif</span><% } %></div><p class="mt-1 text-sm font-medium text-slate-600 dark:text-slate-300">Saldo <strong class="text-slate-900 dark:text-white"><%= formatRupiah(wallet.balance) %></strong></p></div><div class="flex flex-wrap gap-2"><% if (!(activeWallet && activeWallet.id === wallet.id)) { %><form method="post" action="/dompet/select"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="wallet_id" value="<%= wallet.id %>"><button class="rounded-xl border border-slate-300 px-4 py-2.5 text-sm font-bold text-slate-700 hover:bg-slate-50 dark:border-slate-600 dark:text-slate-100 dark:hover:bg-slate-700">Jadikan aktif</button></form><% } %><form method="post" action="/dompet/<%= wallet.id %>/hapus" class="delete-confirm-form" data-confirm-message="Dompet hanya dapat dihapus jika saldo kosong dan tidak memiliki riwayat transaksi."><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="rounded-xl border border-rose-200 px-4 py-2.5 text-sm font-bold text-rose-700 hover:bg-rose-50 dark:border-rose-900 dark:text-rose-300 dark:hover:bg-rose-950/40">Hapus</button></form></div></article><% }) %></div><% } else { %><div class="px-6 py-12 text-center"><h3 class="font-bold text-slate-900 dark:text-white">Belum ada dompet</h3><p class="mt-2 text-sm text-slate-600 dark:text-slate-300">Buat dompet untuk mulai mengelola pencatatan berdasarkan pos.</p></div><% } %></div></section>
</div>
<%- include('partials/footer') %>
