<%- include('partials/header') %>

<div class="row g-7">
  <!--begin::Create Wallet Column-->
  <div class="col-lg-4">
    <div class="card card-flush shadow-sm">
      <div class="card-header py-5">
        <div class="card-title">
          <div>
            <h2 class="fs-4 fw-bolder text-gray-900 mb-0">Buat Dompet Baru</h2>
            <span class="fs-7 text-muted fw-bold">Pisahkan pos pengeluaran Anda</span>
          </div>
        </div>
      </div>
      <div class="card-body pt-0">
        <form method="post" action="/dompet">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
          <div class="fv-row mb-5">
            <label class="required fs-6 fw-bold mb-2">Nama Dompet</label>
            <input type="text" name="name" class="form-control form-control-solid" placeholder="Contoh: Harian, Tabungan, Usaha" maxlength="60" required />
          </div>
          <button type="submit" class="btn btn-primary w-100 fw-bolder">
            <span class="svg-icon svg-icon-2 me-1">
              <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none">
                <rect opacity="0.5" x="11" y="18" width="12" height="2" rx="1" transform="rotate(-90 11 18)" fill="currentColor"/>
                <rect x="6" y="11" width="12" height="2" rx="1" fill="currentColor"/>
              </svg>
            </span>
            Buat Dompet
          </button>
        </form>
      </div>
    </div>
  </div>
  <!--end::Create Wallet Column-->

  <!--begin::Wallets List Column-->
  <div class="col-lg-8">
    <div class="card card-flush shadow-sm">
      <div class="card-header align-items-center py-5">
        <div class="card-title">
          <div>
            <h2 class="fs-4 fw-bolder text-gray-900 mb-0">Daftar Dompet</h2>
            <span class="fs-7 text-muted fw-bold">Kelola dan pilih pos keuangan aktif</span>
          </div>
        </div>
        <div class="card-toolbar">
          <span class="badge badge-light-primary fw-bolder fs-7 px-3 py-2">
            <%= wallets.length %> Dompet Terdaftar
          </span>
        </div>
      </div>

      <div class="card-body pt-0">
        <% if (wallets.length) { %>
        <div class="table-responsive">
          <table class="table align-middle table-row-dashed fs-6 gy-5" id="kt_wallets_table">
            <thead>
              <tr class="text-start text-gray-400 fw-bolder fs-7 text-uppercase gs-0">
                <th class="min-w-150px">Dompet</th>
                <th class="min-w-100px">Status</th>
                <th class="text-end min-w-120px">Saldo</th>
                <th class="text-end min-w-150px">Aksi</th>
              </tr>
            </thead>
            <tbody class="fw-bold text-gray-600">
              <% wallets.forEach(wallet => { 
                const isActive = activeWallet && Number(activeWallet.id) === Number(wallet.id);
              %>
              <tr>
                <td>
                  <div class="d-flex align-items-center">
                    <div class="symbol symbol-40px <%= isActive ? 'symbol-light-success' : 'symbol-light-primary' %> me-3">
                      <span class="symbol-label">
                        <span class="svg-icon svg-icon-3 <%= isActive ? 'svg-icon-success' : 'svg-icon-primary' %>">
                          <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none">
                            <path opacity="0.3" d="M20 15H4C2.9 15 2 14.1 2 13V7C2 6.4 2.4 6 3 6H21C21.6 6 22 6.4 22 7V13C22 14.1 21.1 15 20 15ZM13 12H11C10.5 12 10 12.4 10 13V16C10 16.5 10.4 17 11 17H13C13.6 17 14 16.6 14 16V13C14 12.4 13.6 12 13 12Z" fill="currentColor"/>
                            <path d="M14 6V5H10V6H8V5C8 3.9 8.9 3 10 3H14C15.1 3 16 3.9 16 5V6H14ZM20 15H14V16C14 16.6 13.5 17 13 17H11C10.5 17 10 16.6 10 16V15H4C3.6 15 3.3 14.9 3 14.7V18C3 19.1 3.9 20 5 20H19C20.1 20 21 19.1 21 18V14.7C20.7 14.9 20.4 15 20 15Z" fill="currentColor"/>
                          </svg>
                        </span>
                      </span>
                    </div>
                    <div class="d-flex flex-column">
                      <span class="text-gray-900 fs-6 fw-bolder"><%= wallet.name %></span>
                    </div>
                  </div>
                </td>
                <td>
                  <% if (isActive) { %>
                  <span class="badge badge-light-success fw-bolder fs-7 px-3 py-2">Aktif</span>
                  <% } else { %>
                  <span class="badge badge-light fs-7 px-3 py-2 text-muted">Tersedia</span>
                  <% } %>
                </td>
                <td class="text-end">
                  <span class="fs-6 fw-bolder text-gray-900"><%= formatRupiah(wallet.balance) %></span>
                </td>
                <td class="text-end">
                  <div class="d-inline-flex gap-2">
                    <% if (!isActive) { %>
                    <form method="post" action="/dompet/select" class="m-0 d-inline">
                      <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
                      <input type="hidden" name="wallet_id" value="<%= wallet.id %>" />
                      <button type="submit" class="btn btn-sm btn-light-primary fw-bolder">Pilih</button>
                    </form>
                    <% } %>
                    <form method="post" action="/dompet/<%= wallet.id %>/hapus" class="delete-confirm-form m-0 d-inline" data-confirm-message="Dompet hanya dapat dihapus jika saldo Rp 0 dan tidak memiliki catatan transaksi.">
                      <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
                      <button type="submit" class="btn btn-sm btn-light-danger fw-bolder">Hapus</button>
                    </form>
                  </div>
                </td>
              </tr>
              <% }) %>
            </tbody>
          </table>
        </div>
        <% } else { %>
        <div class="text-center py-12">
          <div class="symbol symbol-60px symbol-circle bg-light-primary mb-4 p-3">
            <span class="svg-icon svg-icon-2x svg-icon-primary">
              <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none">
                <path opacity="0.3" d="M20 15H4C2.9 15 2 14.1 2 13V7C2 6.4 2.4 6 3 6H21C21.6 6 22 6.4 22 7V13C22 14.1 21.1 15 20 15ZM13 12H11C10.5 12 10 12.4 10 13V16C10 16.5 10.4 17 11 17H13C13.6 17 14 16.6 14 16V13C14 12.4 13.6 12 13 12Z" fill="currentColor"/>
                <path d="M14 6V5H10V6H8V5C8 3.9 8.9 3 10 3H14C15.1 3 16 3.9 16 5V6H14ZM20 15H14V16C14 16.6 13.5 17 13 17H11C10.5 17 10 16.6 10 16V15H4C3.6 15 3.3 14.9 3 14.7V18C3 19.1 3.9 20 5 20H19C20.1 20 21 19.1 21 18V14.7C20.7 14.9 20.4 15 20 15Z" fill="currentColor"/>
              </svg>
            </span>
          </div>
          <h3 class="fs-4 fw-bolder text-gray-800 mb-2">Belum ada dompet</h3>
          <p class="fs-6 text-gray-500 mb-0">Gunakan formulir di samping untuk membuat dompet pertama Anda.</p>
        </div>
        <% } %>
      </div>
    </div>
  </div>
  <!--end::Wallets List Column-->
</div>

<%- include('partials/footer') %>
