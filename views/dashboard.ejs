<%- include('partials/header') %>
<div class="mx-auto max-w-7xl space-y-8 px-5 py-8 sm:px-8 lg:px-10">
  <section class="flex flex-col gap-5 sm:flex-row sm:items-end sm:justify-between">
    <div><p class="text-sm font-bold uppercase tracking-[.18em] text-indigo-600 dark:text-indigo-300">Ringkasan keuangan</p><h1 class="mt-2 text-3xl font-bold tracking-tight text-slate-900 dark:text-white sm:text-4xl">Dashboard</h1><p class="mt-2 text-base text-slate-600 dark:text-slate-300">Pantau arus keuangan Anda dalam satu tampilan.</p></div>
    <a class="inline-flex items-center justify-center gap-2 rounded-xl bg-indigo-600 px-5 py-3 text-sm font-bold text-white shadow-lg shadow-indigo-600/20 transition hover:bg-indigo-700 focus:outline-none focus:ring-4 focus:ring-indigo-300 dark:focus:ring-indigo-800" href="/transaksi/tambah"><span class="text-lg">＋</span> Catat transaksi</a>
  </section>
  <section class="relative overflow-hidden rounded-3xl bg-gradient-to-br from-indigo-600 via-indigo-600 to-violet-700 p-7 text-white shadow-xl shadow-indigo-900/15 sm:p-9">
    <div class="absolute -right-10 -top-24 h-72 w-72 rounded-full border-[40px] border-white/10"></div><div class="absolute -bottom-24 right-40 h-48 w-48 rounded-full bg-white/5 blur-2xl"></div>
    <div class="relative max-w-2xl"><span class="inline-flex rounded-full bg-white/15 px-3 py-1.5 text-xs font-bold uppercase tracking-wider text-indigo-50">Bulan ini</span><h2 class="mt-4 text-2xl font-bold sm:text-3xl">Halo, <%= user.name.split(' ')[0] %> 👋</h2><p class="mt-2 text-sm leading-6 text-indigo-100 sm:text-base">Dompet aktif: <strong class="text-white"><%= activeWallet ? activeWallet.name : 'belum dipilih' %></strong>. Ringkasan mengikuti dompet aktif.<% if (!activeWallet) { %> <a class="font-bold underline underline-offset-4" href="/dompet">Pilih dompet</a><% } %></p></div>
    <div class="relative mt-7 grid grid-cols-1 gap-3 sm:grid-cols-3"><div class="rounded-2xl border border-white/15 bg-white/10 p-4 backdrop-blur"><p class="text-sm font-semibold text-indigo-100">Saldo bersih bulan ini</p><p class="mt-2 text-xl font-bold"><%= formatRupiah(balance) %></p></div><div class="rounded-2xl border border-white/15 bg-white/10 p-4 backdrop-blur"><p class="text-sm font-semibold text-indigo-100">Pemasukan</p><p class="mt-2 text-xl font-bold"><%= formatRupiah(income) %></p></div><div class="rounded-2xl border border-white/15 bg-white/10 p-4 backdrop-blur"><p class="text-sm font-semibold text-indigo-100">Pengeluaran</p><p class="mt-2 text-xl font-bold"><%= formatRupiah(expense) %></p></div></div>
  </section>
  <section class="grid gap-4 sm:grid-cols-2 xl:grid-cols-4"><article class="rounded-2xl border border-slate-200 bg-white p-5 shadow-sm dark:border-slate-700 dark:bg-slate-800"><p class="text-sm font-semibold text-slate-600 dark:text-slate-300">Total saldo dompet</p><p class="mt-3 truncate text-2xl font-bold tracking-tight text-slate-900 dark:text-white"><%= activeWallet ? formatRupiah(activeWallet.balance) : 'Rp 0' %></p><p class="mt-2 text-sm text-slate-500 dark:text-slate-400">Dompet aktif</p></article><article class="rounded-2xl border border-slate-200 bg-white p-5 shadow-sm dark:border-slate-700 dark:bg-slate-800"><p class="text-sm font-semibold text-slate-600 dark:text-slate-300">Jumlah transaksi</p><p class="mt-3 text-2xl font-bold tracking-tight text-slate-900 dark:text-white"><%= count %></p><p class="mt-2 text-sm text-slate-500 dark:text-slate-400">Semua waktu</p></article><article class="rounded-2xl border border-slate-200 bg-white p-5 shadow-sm dark:border-slate-700 dark:bg-slate-800"><p class="text-sm font-semibold text-slate-600 dark:text-slate-300">Pemasukan bulan ini</p><p class="mt-3 truncate text-2xl font-bold tracking-tight text-emerald-700 dark:text-emerald-300"><%= formatRupiah(income) %></p><p class="mt-2 text-sm text-slate-500 dark:text-slate-400">Dari dompet aktif</p></article><article class="rounded-2xl border border-slate-200 bg-white p-5 shadow-sm dark:border-slate-700 dark:bg-slate-800"><p class="text-sm font-semibold text-slate-600 dark:text-slate-300">Pengeluaran bulan ini</p><p class="mt-3 truncate text-2xl font-bold tracking-tight text-rose-700 dark:text-rose-300"><%= formatRupiah(expense) %></p><p class="mt-2 text-sm text-slate-500 dark:text-slate-400">Dari dompet aktif</p></article></section>
  <section class="overflow-hidden rounded-2xl border border-slate-200 bg-white shadow-sm dark:border-slate-700 dark:bg-slate-800">
    <div class="flex items-center justify-between gap-4 border-b border-slate-200 px-5 py-5 dark:border-slate-700 sm:px-7"><div><h2 class="text-lg font-bold text-slate-900 dark:text-white">Transaksi terbaru</h2><p class="mt-1 text-sm text-slate-600 dark:text-slate-300">Aktivitas pencatatan terakhir Anda.</p></div><a class="shrink-0 text-sm font-bold text-indigo-700 hover:text-indigo-900 dark:text-indigo-300" href="/transaksi">Lihat semua <span aria-hidden="true">→</span></a></div>
    <% if (recent.length) { %><div class="overflow-x-auto"><table class="min-w-full divide-y divide-slate-200 text-left dark:divide-slate-700"><thead class="bg-slate-50 dark:bg-slate-900/60"><tr><th class="px-5 py-3 text-xs font-bold uppercase tracking-wider text-slate-600 dark:text-slate-300 sm:px-7">Transaksi</th><th class="px-5 py-3 text-xs font-bold uppercase tracking-wider text-slate-600 dark:text-slate-300">ID</th><th class="px-5 py-3 text-xs font-bold uppercase tracking-wider text-slate-600 dark:text-slate-300">Kategori</th><th class="px-5 py-3 text-xs font-bold uppercase tracking-wider text-slate-600 dark:text-slate-300">Tanggal</th><th class="px-5 py-3 text-xs font-bold uppercase tracking-wider text-slate-600 dark:text-slate-300">Sumber</th><th class="px-5 py-3 text-right text-xs font-bold uppercase tracking-wider text-slate-600 dark:text-slate-300 sm:pr-7">Nominal</th></tr></thead><tbody class="divide-y divide-slate-100 dark:divide-slate-700"><% recent.forEach(tx => { %><tr class="transition hover:bg-slate-50 dark:hover:bg-slate-700/40"><td class="px-5 py-4 sm:px-7"><div class="flex items-center gap-3"><span class="grid h-10 w-10 shrink-0 place-items-center rounded-xl <%= tx.kind === 'income' ? 'bg-emerald-50 text-emerald-700 dark:bg-emerald-900/40 dark:text-emerald-300' : 'bg-rose-50 text-rose-700 dark:bg-rose-900/40 dark:text-rose-300' %>"><%= tx.kind === 'income' ? '↓' : '↑' %></span><span class="min-w-0"><a class="block max-w-52 truncate text-sm font-bold text-slate-900 hover:text-indigo-700 dark:text-white dark:hover:text-indigo-300" href="/transaksi/<%= tx.id %>"><%= tx.note || tx.category %></a><span class="mt-1 block text-sm font-medium text-slate-600 dark:text-slate-300"><%= tx.kind === 'income' ? 'Pemasukan' : 'Pengeluaran' %></span></span></div></td><td class="whitespace-nowrap px-5 py-4 text-sm font-semibold text-slate-700 dark:text-slate-200"><a class="text-indigo-700 hover:underline dark:text-indigo-300" href="/transaksi/<%= tx.id %>"><%= formatTransactionReference(tx.id,tx.happened_on) %></a></td><td class="whitespace-nowrap px-5 py-4 text-sm font-semibold text-slate-700 dark:text-slate-200"><%= tx.category %></td><td class="whitespace-nowrap px-5 py-4 text-sm font-semibold text-slate-700 dark:text-slate-200"><%= formatDate(tx.happened_on) %></td><td class="whitespace-nowrap px-5 py-4 text-sm font-semibold text-slate-700 dark:text-slate-200"><%= tx.source === 'whatsapp' ? 'WhatsApp' : 'Manual' %></td><td class="whitespace-nowrap px-5 py-4 text-right text-sm font-bold <%= tx.kind === 'income' ? 'text-emerald-700 dark:text-emerald-300' : 'text-rose-700 dark:text-rose-300' %> sm:pr-7"><%= tx.kind === 'income' ? '+' : '−' %> <%= formatRupiah(tx.amount) %></td></tr><% }) %></tbody></table></div><% } else { %><div class="px-6 py-16 text-center"><span class="mx-auto grid h-14 w-14 place-items-center rounded-2xl bg-indigo-50 text-2xl text-indigo-700 dark:bg-indigo-900/40 dark:text-indigo-300">↔</span><h3 class="mt-4 text-base font-bold text-slate-900 dark:text-white">Belum ada transaksi</h3><p class="mt-2 text-sm text-slate-600 dark:text-slate-300">Mulai dengan mencatat pemasukan atau pengeluaran pertama Anda.</p><a class="mt-5 inline-flex rounded-xl border border-slate-300 px-4 py-2.5 text-sm font-bold text-slate-700 hover:bg-slate-50 dark:border-slate-600 dark:text-slate-100 dark:hover:bg-slate-700" href="/transaksi/tambah">Catat transaksi pertama</a></div><% } %>
  </section>
</div>
<%- include('partials/footer') %>
