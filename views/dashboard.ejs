<%- include('partials/header') %>

<% if (!wallets.length) { %>
<!--begin::No Wallet Card-->
<div class="card card-flush shadow-sm mb-5 mb-xl-8">
  <div class="card-body p-9 text-center">
    <div class="symbol symbol-75px symbol-circle mb-5 bg-light-primary p-4">
      <span class="svg-icon svg-icon-3x svg-icon-primary">
        <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none">
          <path opacity="0.3" d="M20 15H4C2.9 15 2 14.1 2 13V7C2 6.4 2.4 6 3 6H21C21.6 6 22 6.4 22 7V13C22 14.1 21.1 15 20 15ZM13 12H11C10.5 12 10 12.4 10 13V16C10 16.5 10.4 17 11 17H13C13.6 17 14 16.6 14 16V13C14 12.4 13.6 12 13 12Z" fill="currentColor"/>
          <path d="M14 6V5H10V6H8V5C8 3.9 8.9 3 10 3H14C15.1 3 16 3.9 16 5V6H14ZM20 15H14V16C14 16.6 13.5 17 13 17H11C10.5 17 10 16.6 10 16V15H4C3.6 15 3.3 14.9 3 14.7V18C3 19.1 3.9 20 5 20H19C20.1 20 21 19.1 21 18V14.7C20.7 14.9 20.4 15 20 15Z" fill="currentColor"/>
        </svg>
      </span>
    </div>
    <h2 class="fs-2x fw-bolder text-gray-900 mb-3">Buat Dompet Pertama Anda</h2>
    <p class="fs-6 text-gray-600 mb-8 max-w-500px mx-auto">
      Dompet membantu memisahkan pos keuangan Anda. Buat satu dompet utama (misal: "Pribadi" atau "Utama"), lalu semua fitur pencatatan dan laporan akan aktif.
    </p>
    <form class="d-flex flex-column flex-sm-row justify-content-center gap-3 max-w-500px mx-auto" method="post" action="/dompet">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
      <input type="hidden" name="return_to" value="/dashboard" />
      <input type="text" class="form-control form-control-solid flex-grow-1" name="name" maxlength="60" placeholder="Contoh: Dompet Utama" required />
      <button type="submit" class="btn btn-primary px-6 text-nowrap">Buat Dompet</button>
    </form>
  </div>
</div>
<!--end::No Wallet Card-->
<% } else { %>
<!--begin::Welcome Banner-->
<div class="card mb-5 mb-xl-8 bg-dark text-white shadow-sm overflow-hidden" style="background: linear-gradient(135deg, #1e1e2d 0%, #2b2b40 100%);">
  <div class="card-body p-8 p-lg-10">
    <div class="row align-items-center">
      <div class="col-lg-7 mb-5 mb-lg-0">
        <span class="badge badge-light-primary fw-bolder px-3 py-2 mb-3">RINGKASAN BULAN INI</span>
        <h2 class="fs-2hx fw-bolder text-white mb-2">Halo, <%= user.name.split(' ')[0] %> 👋</h2>
        <p class="text-gray-400 fs-6 mb-0">
          Dompet aktif: <strong class="text-white"><%= activeWallet ? activeWallet.name : 'belum dipilih' %></strong>.
          <% if (!activeWallet) { %>
            <a class="text-primary fw-bold text-decoration-underline ms-2" href="/dompet">Pilih Dompet</a>
          <% } %>
        </p>
      </div>
      <div class="col-lg-5 text-lg-end">
        <a href="/transaksi/tambah" class="btn btn-primary fw-bolder px-6 py-3 shadow">
          <span class="svg-icon svg-icon-2 me-2">
            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none">
              <rect opacity="0.5" x="11" y="18" width="12" height="2" rx="1" transform="rotate(-90 11 18)" fill="currentColor"/>
              <rect x="6" y="11" width="12" height="2" rx="1" fill="currentColor"/>
            </svg>
          </span>
          Catat Transaksi
        </a>
      </div>
    </div>
    <div class="separator separator-dashed my-6 border-gray-700"></div>
    <div class="row g-4">
      <div class="col-md-4">
        <div class="bg-gray-800 bg-opacity-50 rounded p-4 border border-gray-700">
          <div class="text-gray-400 fs-7 fw-bold mb-1">Saldo Bersih Bulan Ini</div>
          <div class="fs-2x fw-bolder <%= balance >= 0 ? 'text-success' : 'text-danger' %>"><%= formatRupiah(balance) %></div>
        </div>
      </div>
      <div class="col-md-4">
        <div class="bg-gray-800 bg-opacity-50 rounded p-4 border border-gray-700">
          <div class="text-gray-400 fs-7 fw-bold mb-1">Pemasukan Bulan Ini</div>
          <div class="fs-2x fw-bolder text-success">+ <%= formatRupiah(income) %></div>
        </div>
      </div>
      <div class="col-md-4">
        <div class="bg-gray-800 bg-opacity-50 rounded p-4 border border-gray-700">
          <div class="text-gray-400 fs-7 fw-bold mb-1">Pengeluaran Bulan Ini</div>
          <div class="fs-2x fw-bolder text-danger">− <%= formatRupiah(expense) %></div>
        </div>
      </div>
    </div>
  </div>
</div>
<!--end::Welcome Banner-->

<!--begin::Stats Widgets-->
<div class="row g-5 g-xl-8 mb-5 mb-xl-8">
  <div class="col-sm-6 col-xl-3">
    <div class="card card-flush h-100 shadow-sm">
      <div class="card-body d-flex flex-column justify-content-between p-6">
        <div class="d-flex align-items-center mb-3">
          <div class="symbol symbol-45px symbol-light-primary me-4">
            <span class="symbol-label">
              <span class="svg-icon svg-icon-2x svg-icon-primary">
                <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none">
                  <path opacity="0.3" d="M20 15H4C2.9 15 2 14.1 2 13V7C2 6.4 2.4 6 3 6H21C21.6 6 22 6.4 22 7V13C22 14.1 21.1 15 20 15ZM13 12H11C10.5 12 10 12.4 10 13V16C10 16.5 10.4 17 11 17H13C13.6 17 14 16.6 14 16V13C14 12.4 13.6 12 13 12Z" fill="currentColor"/>
                  <path d="M14 6V5H10V6H8V5C8 3.9 8.9 3 10 3H14C15.1 3 16 3.9 16 5V6H14ZM20 15H14V16C14 16.6 13.5 17 13 17H11C10.5 17 10 16.6 10 16V15H4C3.6 15 3.3 14.9 3 14.7V18C3 19.1 3.9 20 5 20H19C20.1 20 21 19.1 21 18V14.7C20.7 14.9 20.4 15 20 15Z" fill="currentColor"/>
                </svg>
              </span>
            </span>
          </div>
          <div>
            <div class="text-gray-400 fw-bold fs-7">Total Saldo Dompet</div>
            <div class="text-gray-900 fw-bolder fs-4"><%= activeWallet ? formatRupiah(activeWallet.balance) : 'Rp 0' %></div>
          </div>
        </div>
        <div class="text-muted fs-8">Dompet: <strong><%= activeWallet ? activeWallet.name : '—' %></strong></div>
      </div>
    </div>
  </div>

  <div class="col-sm-6 col-xl-3">
    <div class="card card-flush h-100 shadow-sm">
      <div class="card-body d-flex flex-column justify-content-between p-6">
        <div class="d-flex align-items-center mb-3">
          <div class="symbol symbol-45px symbol-light-primary me-4">
            <span class="symbol-label">
              <span class="svg-icon svg-icon-2x svg-icon-primary">
                <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none">
                  <path opacity="0.3" d="M14 3V21H10V3C10 2.4 10.4 2 11 2H13C13.6 2 14 2.4 14 3ZM7 14H5C4.4 14 4 14.4 4 15V21H8V15C8 14.4 7.6 14 7 14Z" fill="currentColor"/>
                  <path d="M21 20H20V8C20 7.4 19.6 7 19 7H17C16.4 7 16 7.4 16 8V20H3C2.4 20 2 20.4 2 21C2 21.6 2.4 22 3 22H21C21.6 22 22 21.6 22 21C22 20.4 21.6 20 21 20Z" fill="currentColor"/>
                </svg>
              </span>
            </span>
          </div>
          <div>
            <div class="text-gray-400 fw-bold fs-7">Jumlah Catatan</div>
            <div class="text-gray-900 fw-bolder fs-2hx lh-1"><%= count %></div>
          </div>
        </div>
        <div class="text-muted fs-8">Total seluruh transaksi</div>
      </div>
    </div>
  </div>

  <div class="col-sm-6 col-xl-3">
    <div class="card card-flush h-100 shadow-sm">
      <div class="card-body d-flex flex-column justify-content-between p-6">
        <div class="d-flex align-items-center mb-3">
          <div class="symbol symbol-45px symbol-light-success me-4">
            <span class="symbol-label">
              <span class="svg-icon svg-icon-2x svg-icon-success">
                <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none">
                  <rect opacity="0.5" x="11" y="18" width="13" height="2" rx="1" transform="rotate(-90 11 18)" fill="currentColor"/>
                  <path d="M11.4343 15.4343L7.25 11.25C6.83579 10.8358 6.16421 10.8358 5.75 11.25C5.33579 11.6642 5.33579 12.3358 5.75 12.75L11.2929 18.2929C11.6834 18.6834 12.3166 18.6834 12.7071 18.2929L18.25 12.75C18.6642 12.3358 18.6642 11.6642 18.25 11.25L12.5657 15.4343C12.2533 15.7467 11.7467 15.7467 11.4343 15.4343Z" fill="currentColor"/>
                </svg>
              </span>
            </span>
          </div>
          <div>
            <div class="text-gray-400 fw-bold fs-7">Pemasukan Bulan Ini</div>
            <div class="text-success fw-bolder fs-4"><%= formatRupiah(income) %></div>
          </div>
        </div>
        <div class="text-muted fs-8">Dari dompet aktif</div>
      </div>
    </div>
  </div>

  <div class="col-sm-6 col-xl-3">
    <div class="card card-flush h-100 shadow-sm">
      <div class="card-body d-flex flex-column justify-content-between p-6">
        <div class="d-flex align-items-center mb-3">
          <div class="symbol symbol-45px symbol-light-danger me-4">
            <span class="symbol-label">
              <span class="svg-icon svg-icon-2x svg-icon-danger">
                <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none">
                  <rect opacity="0.5" x="13" y="6" width="13" height="2" rx="1" transform="rotate(90 13 6)" fill="currentColor"/>
                  <path d="M12.5657 8.56569L16.75 12.75C17.1642 13.1642 17.8358 13.1642 18.25 12.75C18.6642 12.3358 18.6642 11.6642 18.25 11.25L12.7071 5.70711C12.3166 5.31658 11.6834 5.31658 11.2929 5.70711L5.75 11.25C5.33579 11.6642 5.33579 12.3358 5.75 12.75C6.16421 13.1642 6.83579 13.1642 7.25 12.75L11.4343 8.56569C11.7467 8.25327 12.2533 8.25327 12.5657 8.56569Z" fill="currentColor"/>
                </svg>
              </span>
            </span>
          </div>
          <div>
            <div class="text-gray-400 fw-bold fs-7">Pengeluaran Bulan Ini</div>
            <div class="text-danger fw-bolder fs-4"><%= formatRupiah(expense) %></div>
          </div>
        </div>
        <div class="text-muted fs-8">Dari dompet aktif</div>
      </div>
    </div>
  </div>
</div>
<!--end::Stats Widgets-->

<!--begin::Recent Transactions Table-->
<div class="card card-flush shadow-sm">
  <div class="card-header align-items-center py-5 gap-2 gap-md-5">
    <div class="card-title">
      <div>
        <h2 class="fs-4 fw-bolder text-gray-900 mb-0">Transaksi Terbaru</h2>
        <span class="fs-7 text-muted fw-bold">Aktivitas pencatatan terakhir Anda</span>
      </div>
    </div>
    <div class="card-toolbar">
      <a href="/transaksi" class="btn btn-sm btn-light-primary fw-bolder">
        Lihat Semua Transaksi
        <span class="svg-icon svg-icon-5 ms-1">
          <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none">
            <rect opacity="0.5" x="18" y="13" width="13" height="2" rx="1" transform="rotate(-180 18 13)" fill="currentColor"/>
            <path d="M15.4343 12.5657L11.25 16.75C10.8358 17.1642 10.8358 17.8358 11.25 18.25C11.6642 18.6642 12.3358 18.6642 12.75 18.25L18.2929 12.7071C18.6834 12.3166 18.6834 11.6834 18.2929 11.2929L12.75 5.75C12.3358 5.33579 11.6642 5.33579 11.25 5.75C10.8358 6.16421 10.8358 6.83579 11.25 7.25L15.4343 11.4343C15.7467 11.7467 15.7467 12.2533 15.4343 12.5657Z" fill="currentColor"/>
          </svg>
        </span>
      </a>
    </div>
  </div>

  <div class="card-body pt-0">
    <% if (recent.length) { %>
    <div class="table-responsive">
      <table class="table align-middle table-row-dashed fs-6 gy-5" id="kt_dashboard_recent_table">
        <thead>
          <tr class="text-start text-gray-400 fw-bolder fs-7 text-uppercase gs-0">
            <th class="min-w-200px">Transaksi</th>
            <th class="min-w-120px">ID Transaksi</th>
            <th class="min-w-120px">Kategori</th>
            <th class="min-w-120px">Tanggal</th>
            <th class="min-w-100px">Sumber</th>
            <th class="text-end min-w-120px">Nominal</th>
          </tr>
        </thead>
        <tbody class="fw-bold text-gray-600">
          <% recent.forEach(tx => { 
            const isIncome = tx.kind === 'income';
          %>
          <tr>
            <td>
              <div class="d-flex align-items-center">
                <div class="symbol symbol-40px <%= isIncome ? 'symbol-light-success' : 'symbol-light-danger' %> me-3">
                  <span class="symbol-label">
                    <span class="svg-icon svg-icon-3 <%= isIncome ? 'svg-icon-success' : 'svg-icon-danger' %>">
                      <% if (isIncome) { %>
                      <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none">
                        <rect opacity="0.5" x="11" y="18" width="13" height="2" rx="1" transform="rotate(-90 11 18)" fill="currentColor"/>
                        <path d="M11.4343 15.4343L7.25 11.25C6.83579 10.8358 6.16421 10.8358 5.75 11.25C5.33579 11.6642 5.33579 12.3358 5.75 12.75L11.2929 18.2929C11.6834 18.6834 12.3166 18.6834 12.7071 18.2929L18.25 12.75C18.6642 12.3358 18.6642 11.6642 18.25 11.25L12.5657 15.4343C12.2533 15.7467 11.7467 15.7467 11.4343 15.4343Z" fill="currentColor"/>
                      </svg>
                      <% } else { %>
                      <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none">
                        <rect opacity="0.5" x="13" y="6" width="13" height="2" rx="1" transform="rotate(90 13 6)" fill="currentColor"/>
                        <path d="M12.5657 8.56569L16.75 12.75C17.1642 13.1642 17.8358 13.1642 18.25 12.75C18.6642 12.3358 18.6642 11.6642 18.25 11.25L12.7071 5.70711C12.3166 5.31658 11.6834 5.31658 11.2929 5.70711L5.75 11.25C5.33579 11.6642 5.33579 12.3358 5.75 12.75C6.16421 13.1642 6.83579 13.1642 7.25 12.75L11.4343 8.56569C11.7467 8.25327 12.2533 8.25327 12.5657 8.56569Z" fill="currentColor"/>
                      </svg>
                      <% } %>
                    </span>
                  </span>
                </div>
                <div class="d-flex flex-column">
                  <a href="/transaksi/<%= tx.id %>" class="text-gray-800 text-hover-primary fs-6 fw-bolder"><%= tx.note || tx.category %></a>
                  <span class="text-muted fw-bold fs-7"><%= isIncome ? 'Pemasukan' : 'Pengeluaran' %></span>
                </div>
              </div>
            </td>
            <td>
              <a href="/transaksi/<%= tx.id %>" class="text-primary fw-bolder"><%= formatTransactionReference(tx.id, tx.happened_on) %></a>
            </td>
            <td>
              <span class="badge badge-light fw-bolder fs-7"><%= tx.category %></span>
            </td>
            <td class="text-gray-600 fw-bold">
              <%= formatDate(tx.happened_on) %>
            </td>
            <td>
              <span class="badge badge-light-<%= tx.source === 'whatsapp' ? 'success' : 'primary' %> fs-7">
                <%= tx.source === 'whatsapp' ? 'WhatsApp' : 'Manual' %>
              </span>
            </td>
            <td class="text-end">
              <span class="fs-6 fw-bolder <%= isIncome ? 'text-success' : 'text-danger' %>">
                <%= isIncome ? '+' : '−' %> <%= formatRupiah(tx.amount) %>
              </span>
            </td>
          </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
    <% } else { %>
    <div class="text-center py-15">
      <div class="symbol symbol-60px symbol-circle bg-light-primary mb-4 p-3">
        <span class="svg-icon svg-icon-2x svg-icon-primary">
          <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none">
            <path opacity="0.3" d="M3.20001 5.91897L16.9 3.01895C17.4 2.91895 18 3.219 18.1 3.819L19.2 9.01895L3.20001 5.91897Z" fill="currentColor"/>
            <path d="M13 13.9189C13 12.2189 14.3 10.9189 16 10.9189H21V7.91895C21 6.81895 20.1 5.91895 19 5.91895H3C2.4 5.91895 2 6.31895 2 6.91895V20.9189C2 21.5189 2.4 21.9189 3 21.9189H19C20.1 21.9189 21 21.0189 21 19.9189V16.9189H16C14.3 16.9189 13 15.6189 13 13.9189Z" fill="currentColor"/>
          </svg>
        </span>
      </div>
      <h3 class="fs-4 fw-bolder text-gray-800 mb-2">Belum ada transaksi</h3>
      <p class="fs-6 text-gray-500 mb-5">Mulai dengan mencatat pemasukan atau pengeluaran pertama Anda.</p>
      <a href="/transaksi/tambah" class="btn btn-sm btn-primary">Catat Transaksi Pertama</a>
    </div>
    <% } %>
  </div>
</div>
<!--end::Recent Transactions Table-->
<% } %>

<%- include('partials/footer') %>
