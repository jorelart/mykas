<%- include('partials/header') %><div class="page-heading"><div><div class="eyebrow">RINGKASAN KEUANGAN</div><h1>Dashboard</h1><p>Pantau arus keuangan Anda dalam satu tampilan.</p></div><a class="button primary" href="/transaksi/tambah"><span class="plus">＋</span> Catat transaksi</a></div><div class="welcome-strip"><div><span class="welcome-tag">BULAN INI</span><h2>Halo, <%= user.name.split(' ')[0] %> 👋</h2><p>Ini ringkasan aktivitas keuangan Anda bulan ini.</p></div><div class="strip-decoration"><span>↗</span><small>FINANCIAL<br>OVERVIEW</small></div></div><div class="stats-grid"><article class="stat-card"><div class="stat-top"><span>Total saldo bersih</span><span class="stat-icon indigo">◈</span></div><strong class="stat-value"><%= formatRupiah(balance) %></strong><div class="stat-caption"><span class="caption-dot indigo-dot"></span>Akumulasi bulan ini</div></article><article class="stat-card"><div class="stat-top"><span>Total pemasukan</span><span class="stat-icon green">↓</span></div><strong class="stat-value"><%= formatRupiah(income) %></strong><div class="stat-caption"><span class="caption-dot green-dot"></span>Pemasukan bulan ini</div></article><article class="stat-card"><div class="stat-top"><span>Total pengeluaran</span><span class="stat-icon orange">↑</span></div><strong class="stat-value"><%= formatRupiah(expense) %></strong><div class="stat-caption"><span class="caption-dot orange-dot"></span>Pengeluaran bulan ini</div></article><article class="stat-card"><div class="stat-top"><span>Jumlah transaksi</span><span class="stat-icon violet">≋</span></div><strong class="stat-value"><%= count %> <small>transaksi</small></strong><div class="stat-caption"><span class="caption-dot violet-dot"></span>Semua waktu</div></article></div><div class="section-heading"><div><h2>Transaksi terbaru</h2><p>Aktivitas pencatatan terakhir Anda.</p></div><a class="text-link" href="/transaksi">Lihat semua <span>→</span></a></div><div class="table-card"><% if (recent.length) { %><div class="table-scroll"><table><thead><tr><th>TRANSAKSI</th><th>KATEGORI</th><th>TANGGAL</th><th>SUMBER</th><th class="align-right">NOMINAL</th></tr></thead><tbody><% recent.forEach(tx => { %><tr><td><span class="transaction-title"><i class="kind-icon <%= tx.kind %>"><%= tx.kind === 'income' ? '↓' : '↑' %></i><span><strong><%= tx.note || tx.category %></strong><small><%= tx.kind === 'income' ? 'Pemasukan' : 'Pengeluaran' %></small></span></span></td><td><span class="category-chip"><%= tx.category %></span></td><td><%= formatDate(tx.happened_on) %></td><td><span class="source-label"><%= tx.source === 'whatsapp' ? 'WhatsApp' : 'Manual' %></span></td><td class="align-right amount <%= tx.kind %>"><%= tx.kind === 'income' ? '+' : '−' %> <%= formatRupiah(tx.amount) %></td></tr><% }) %></tbody></table></div><% } else { %><div class="empty-state"><span class="empty-icon">↔</span><strong>Belum ada transaksi</strong><p>Mulai dengan mencatat pemasukan atau pengeluaran pertama Anda.</p><a class="button secondary" href="/transaksi/tambah">Catat transaksi pertama</a></div><% } %></div><%- include('partials/footer') %>
