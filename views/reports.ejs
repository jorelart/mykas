<%- include('partials/header') %>
<div class="mx-auto max-w-7xl space-y-7 px-5 py-8 sm:px-8 lg:px-10"><section><p class="text-sm font-bold uppercase tracking-[.18em] text-indigo-600 dark:text-indigo-300">Analisis keuangan</p><h1 class="mt-2 text-3xl font-bold tracking-tight text-slate-900 dark:text-white sm:text-4xl">Laporan</h1><p class="mt-2 text-base text-slate-600 dark:text-slate-300">Laporan untuk dompet aktif: <strong class="text-slate-900 dark:text-white"><%= activeWallet ? activeWallet.name : 'belum dipilih' %></strong>.<% if (!activeWallet) { %> <a class="font-bold text-indigo-700 underline dark:text-indigo-300" href="/dompet">Pilih dompet</a><% } %></p></section>
<form class="grid gap-4 rounded-2xl border border-slate-200 bg-white p-4 shadow-sm dark:border-slate-700 dark:bg-slate-800 sm:grid-cols-2 xl:grid-cols-4 xl:items-end" method="get"><label class="grid gap-1.5 text-sm font-semibold text-slate-700 dark:text-slate-200">Jenis transaksi<select class="h-11 rounded-xl border border-slate-300 bg-white px-3 text-sm text-slate-900 outline-none focus:border-indigo-500 focus:ring-4 focus:ring-indigo-500/15 dark:border-slate-600 dark:bg-slate-900 dark:text-white" name="jenis"><option value="">Semua jenis</option><option value="income" <%= kind === 'income' ? 'selected' : '' %>>Pemasukan</option><option value="expense" <%= kind === 'expense' ? 'selected' : '' %>>Pengeluaran</option></select></label><label class="grid gap-1.5 text-sm font-semibold text-slate-700 dark:text-slate-200">Dari tanggal<input class="h-11 rounded-xl border border-slate-300 bg-white px-3 text-sm text-slate-900 outline-none focus:border-indigo-500 focus:ring-4 focus:ring-indigo-500/15 dark:border-slate-600 dark:bg-slate-900 dark:text-white" type="date" name="dari" value="<%= start %>" required></label><label class="grid gap-1.5 text-sm font-semibold text-slate-700 dark:text-slate-200">Sampai tanggal<input class="h-11 rounded-xl border border-slate-300 bg-white px-3 text-sm text-slate-900 outline-none focus:border-indigo-500 focus:ring-4 focus:ring-indigo-500/15 dark:border-slate-600 dark:bg-slate-900 dark:text-white" type="date" name="sampai" value="<%= end %>" required></label><button class="h-11 rounded-xl bg-indigo-600 px-5 text-sm font-bold text-white hover:bg-indigo-700">Tampilkan laporan</button></form>
<section class="grid gap-4 sm:grid-cols-2 xl:grid-cols-3"><article class="rounded-2xl border border-emerald-200 bg-emerald-50 p-5 dark:border-emerald-900/60 dark:bg-emerald-950/35"><p class="text-sm font-semibold text-emerald-800 dark:text-emerald-200">Total pemasukan</p><p class="mt-2 text-2xl font-bold text-emerald-900 dark:text-emerald-100"><%= formatRupiah(income) %></p><p class="mt-2 text-sm text-emerald-800/80 dark:text-emerald-200/80">Dalam periode terpilih</p></article><article class="rounded-2xl border border-rose-200 bg-rose-50 p-5 dark:border-rose-900/60 dark:bg-rose-950/35"><p class="text-sm font-semibold text-rose-800 dark:text-rose-200">Total pengeluaran</p><p class="mt-2 text-2xl font-bold text-rose-900 dark:text-rose-100"><%= formatRupiah(expense) %></p><p class="mt-2 text-sm text-rose-800/80 dark:text-rose-200/80">Dalam periode terpilih</p></article><article class="rounded-2xl border border-indigo-200 bg-indigo-50 p-5 dark:border-indigo-900/60 dark:bg-indigo-950/35 sm:col-span-2 xl:col-span-1"><p class="text-sm font-semibold text-indigo-800 dark:text-indigo-200">Selisih bersih</p><p class="mt-2 text-2xl font-bold text-indigo-900 dark:text-indigo-100"><%= formatRupiah(income-expense) %></p><p class="mt-2 text-sm text-indigo-800/80 dark:text-indigo-200/80">Pemasukan dikurangi pengeluaran</p></article></section>
<% const tableClass = 'min-w-full divide-y divide-slate-200 text-left dark:divide-slate-700'; const thClass = 'px-5 py-3 text-xs font-bold uppercase tracking-wider text-slate-600 dark:text-slate-300'; const tdClass = 'whitespace-nowrap px-5 py-4 text-sm font-semibold text-slate-700 dark:text-slate-200'; %>
<section class="overflow-hidden rounded-2xl border border-slate-200 bg-white shadow-sm dark:border-slate-700 dark:bg-slate-800"><div class="border-b border-slate-200 px-5 py-4 dark:border-slate-700"><h2 class="font-bold text-slate-900 dark:text-white">Ringkasan kategori</h2><p class="mt-1 text-sm text-slate-600 dark:text-slate-300">Akumulasi nilai per kategori untuk periode ini.</p></div><% if (categories.length) { %><div class="overflow-x-auto"><table class="<%= tableClass %>"><thead class="bg-slate-50 dark:bg-slate-900/60"><tr><th class="<%= thClass %>">Kategori</th><th class="<%= thClass %>">Jenis</th><th class="<%= thClass %> text-right">Total</th></tr></thead><tbody class="divide-y divide-slate-100 dark:divide-slate-700"><% categories.forEach(row => { %><tr><td class="<%= tdClass %>"><%= row.category %></td><td class="<%= tdClass %>"><%= row.kind === 'income' ? 'Pemasukan' : 'Pengeluaran' %></td><td class="<%= tdClass %> text-right font-bold <%= row.kind === 'income' ? 'text-emerald-700 dark:text-emerald-300' : 'text-rose-700 dark:text-rose-300' %>"><%= formatRupiah(row.total) %></td></tr><% }) %></tbody></table></div><% } else { %><div class="p-8 text-center text-sm text-slate-600 dark:text-slate-300">Belum ada data pada periode ini.</div><% } %></section>
<section class="overflow-hidden rounded-2xl border border-slate-200 bg-white shadow-sm dark:border-slate-700 dark:bg-slate-800"><div class="border-b border-slate-200 px-5 py-4 dark:border-slate-700"><h2 class="font-bold text-slate-900 dark:text-white">Rincian transaksi</h2><p class="mt-1 text-sm text-slate-600 dark:text-slate-300">Hingga 500 transaksi pada periode yang dipilih.</p></div><% if (rows.length) { %><div class="overflow-x-auto"><table class="<%= tableClass %>"><thead class="bg-slate-50 dark:bg-slate-900/60"><tr><th class="<%= thClass %>">ID transaksi</th><th class="<%= thClass %>">Tanggal</th><th class="<%= thClass %>">Keterangan</th><th class="<%= thClass %>">Kategori</th><th class="<%= thClass %>">Jenis</th><th class="<%= thClass %> text-right">Nominal</th></tr></thead><tbody class="divide-y divide-slate-100 dark:divide-slate-700"><% rows.forEach(tx => { %><tr class="hover:bg-slate-50 dark:hover:bg-slate-700/40"><td class="<%= tdClass %>"><a class="text-indigo-700 hover:underline dark:text-indigo-300" href="/transaksi/<%= tx.id %>"><%= formatTransactionReference(tx.id,tx.happened_on) %></a></td><td class="<%= tdClass %>"><%= formatDate(tx.happened_on) %></td><td class="<%= tdClass %>"><a class="hover:text-indigo-700 dark:hover:text-indigo-300" href="/transaksi/<%= tx.id %>"><%= tx.note || '—' %></a></td><td class="<%= tdClass %>"><%= tx.category %></td><td class="<%= tdClass %>"><%= tx.kind === 'income' ? 'Pemasukan' : 'Pengeluaran' %></td><td class="<%= tdClass %> text-right font-bold <%= tx.kind === 'income' ? 'text-emerald-700 dark:text-emerald-300' : 'text-rose-700 dark:text-rose-300' %>"><%= formatRupiah(tx.amount) %></td></tr><% }) %></tbody></table></div><% } else { %><div class="p-8 text-center text-sm text-slate-600 dark:text-slate-300">Tidak ada transaksi pada periode ini.</div><% } %></section>
<section class="rounded-2xl border border-slate-200 bg-white p-5 dark:border-slate-700 dark:bg-slate-800" id="whatsapp"><p class="text-xs font-bold uppercase tracking-wider text-emerald-700 dark:text-emerald-300">Integrasi WhatsApp</p><h2 class="mt-2 text-lg font-bold text-slate-900 dark:text-white">Catat transaksi dari chat</h2><p class="mt-2 text-sm leading-6 text-slate-600 dark:text-slate-300">Atur webhook Evolution API ke <code class="break-all rounded bg-slate-100 px-1.5 py-1 text-xs dark:bg-slate-900"><%= publicUrl %>/api/webhook/evolution</code> dan samakan secret dengan <code>EVOLUTION_WEBHOOK_SECRET</code>.</p><div class="mt-4 flex flex-wrap gap-2"><code class="rounded-lg bg-emerald-50 px-3 py-2 text-sm font-semibold text-emerald-800 dark:bg-emerald-950 dark:text-emerald-200">/masuk 50000 Gaji</code><code class="rounded-lg bg-emerald-50 px-3 py-2 text-sm font-semibold text-emerald-800 dark:bg-emerald-950 dark:text-emerald-200">/keluar 25000 Makan siang</code></div><p class="mt-3 text-sm text-slate-500 dark:text-slate-400">Nomor pengirim harus sama dengan nomor WhatsApp akun. Secret diterima melalui header x-webhook-secret atau parameter URL.</p></section></div>
<%- include('partials/footer') %>
